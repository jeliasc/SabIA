@model Proyecto_Final.ViewModels.Prototipo.FormularioModuloPrototipo

@{
    var accion = Model.EsEdicion ? Model.Modulo.EtiquetaEditar : Model.Modulo.EtiquetaCrear;
    ViewData["Title"] = $"{accion} - {Model.Modulo.Titulo}";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <i class="@Model.Modulo.Icono fs-4 text-primary"></i>
                <h2 class="fw-semibold mb-0">@accion</h2>
                <span class="badge text-bg-info">PROTOTIPO</span>
            </div>
            <p class="text-body-secondary mb-0">@Model.Modulo.Titulo · formulario de demostración.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Regresar
        </a>
    </div>

    <div class="alert alert-info border-0 shadow-sm">
        <i class="bi bi-info-circle me-1"></i>
        El botón Guardar demuestra el flujo visual, pero no modifica la base de datos.
    </div>

    <form asp-action="Guardar" method="post">
        @Html.AntiForgeryToken()

        @if (Model.Id.HasValue)
        {
            <input type="hidden" name="Id" value="@Model.Id" />
        }

        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header">
                <h3 class="card-title mb-0">Datos del registro</h3>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var campo in Model.Modulo.CamposFormulario)
                    {
                        var valor = Model.EsEdicion
                            ? campo.ValorEjemplo ?? $"Ejemplo {campo.Etiqueta.ToLowerInvariant()}"
                            : campo.ValorEjemplo;

                        <div class="@(campo.Tipo == "textarea" ? "col-12" : "col-12 col-md-6")">
                            <label class="form-label" for="@campo.Nombre">
                                @campo.Etiqueta
                                @if (campo.Requerido)
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>

                            @if (campo.Tipo == "select")
                            {
                                <select class="form-select" id="@campo.Nombre" name="@campo.Nombre">
                                    <option value="">Seleccione una opción</option>
                                    @foreach (var opcion in campo.Opciones)
                                    {
                                        <option selected="@(Model.EsEdicion && opcion == campo.Opciones.FirstOrDefault())">@opcion</option>
                                    }
                                </select>
                            }
                            else if (campo.Tipo == "textarea")
                            {
                                <textarea class="form-control" id="@campo.Nombre" name="@campo.Nombre" rows="4" placeholder="@campo.Placeholder">@valor</textarea>
                            }
                            else
                            {
                                <input class="form-control"
                                       id="@campo.Nombre"
                                       name="@campo.Nombre"
                                       type="@campo.Tipo"
                                       value="@valor"
                                       placeholder="@campo.Placeholder" />
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy me-1"></i>Guardar demostración
                </button>
            </div>
        </div>
    </form>
</div>
