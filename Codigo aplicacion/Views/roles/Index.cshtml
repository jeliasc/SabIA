@model List<Proyecto_Final.Models.Rol>

@{
    ViewData["Title"] = "Roles";
}

<div class="container-fluid">

    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <i class="bi bi-shield-lock fs-4 text-primary"></i>

                <h2 class="mb-0 fw-semibold">
                    Roles
                </h2>
            </div>

            <p class="text-body-secondary mb-0">
                Administración de roles del sistema.
            </p>
        </div>

        @if (User.HasClaim(
            TiposClaims.Permiso,
            Permisos.Roles.Crear))
        {
            <a asp-action="Crear"
               class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Nuevo rol
            </a>
        }

    </div>

    <div class="card card-outline card-primary shadow-sm">

        <div class="card-header d-flex align-items-center justify-content-between">

            <h3 class="card-title mb-0">
                Roles registrados
            </h3>

            <span class="text-body-secondary small">
                @Model.Count registros
            </span>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Estado</th>
                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var rol in Model)
                        {
                            var esSuperusuario =
                                string.Equals(
                                    rol.Name,
                                    Roles.Superusuario,
                                    StringComparison.OrdinalIgnoreCase
                                );

                            <tr>

                                <td class="fw-semibold">
                                    @rol.Name
                                </td>

                                <td>

                                    @if (rol.Activo)
                                    {
                                        <span class="badge text-bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td class="text-end text-nowrap">

                                    @if (!esSuperusuario &&
                                        User.HasClaim(
                                            TiposClaims.Permiso,
                                            Permisos.Roles.Editar))
                                    {
                                        <a asp-action="Editar"
                                           asp-route-id="@rol.Id"
                                           class="btn btn-outline-primary btn-sm">

                                            <i class="bi bi-pencil"></i>

                                            <span class="d-none d-xl-inline">
                                                Editar
                                            </span>

                                        </a>
                                    }

                                    @if (rol.Activo)
                                    {
                                        @if (!esSuperusuario &&
                                        User.HasClaim(
                                            TiposClaims.Permiso,
                                            Permisos.Roles.CambiarEstado))
                                        {
                                            <form asp-action="Desactivar"
                                                  method="post"
                                                  class="d-inline formulario-cambiar-estado"
                                                  data-accion="desactivar"
                                                  data-nombre="@rol.Name">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@rol.Id" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm">

                                                    <i class="bi bi-shield-x"></i>

                                                    <span class="d-none d-xl-inline">
                                                        Desactivar
                                                    </span>

                                                </button>

                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        @if (!esSuperusuario &&
                                            User.HasClaim(
                                                TiposClaims.Permiso,
                                                Permisos.Roles.CambiarEstado))
                                        {
                                            <form asp-action="Activar"
                                                  method="post"
                                                  class="d-inline formulario-cambiar-estado"
                                                  data-accion="activar"
                                                  data-nombre="@rol.Name">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@rol.Id" />

                                                <button type="submit"
                                                        class="btn btn-outline-success btn-sm">

                                                    <i class="bi bi-shield-check"></i>

                                                    <span class="d-none d-xl-inline">
                                                        Activar
                                                    </span>

                                                </button>

                                            </form>
                                        }
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/js/roles.js"
            asp-append-version="true"></script>
}