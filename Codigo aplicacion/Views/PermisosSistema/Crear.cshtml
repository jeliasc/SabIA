@model Proyecto_Final.ViewModels.PermisosSistema.CrearPermiso

@{
    ViewData["Title"] = "Nuevo permiso";
}

<div class="container-fluid">

    <div class="d-flex align-items-center gap-2 mb-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary btn-sm">

            <i class="bi bi-arrow-left"></i>

        </a>

        <div>
            <h2 class="mb-0 fw-semibold">
                Nuevo permiso
            </h2>

            <p class="text-body-secondary mb-0">
                Registre un nuevo permiso para el sistema.
            </p>
        </div>

    </div>

    <div class="row">

        <div class="col-12 col-lg-8 col-xl-6">

            <div class="card card-outline card-primary shadow-sm">

                <div class="card-header">

                    <h3 class="card-title mb-0">
                        Información del permiso
                    </h3>

                </div>

                <div class="card-body">

                    <form asp-action="Crear"
                          method="post"
                          data-modo="crear">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <partial name="Formulario"
                                 model="Model" />

                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-floppy me-1"></i>
                                Guardar permiso

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/permisos-sistema.js"
            asp-append-version="true"></script>
}