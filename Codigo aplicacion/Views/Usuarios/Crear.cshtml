@model Proyecto_Final.ViewModels.Usuarios.CrearUsuario

@{
    ViewData["Title"] = "Nuevo usuario";

    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors
        .Select(error => error.ErrorMessage)
        .Where(mensaje => !string.IsNullOrWhiteSpace(mensaje))
        .ToList();

    var rolesDisponibles =
        ViewBag.RolesDisponibles as IEnumerable<string>
        ?? Enumerable.Empty<string>();
}

@if (erroresGenerales?.Any() == true)
{
    <div data-alerta data-tipo="error" data-titulo="Crear usuario" data-mensaje="@string.Join(" ", erroresGenerales)"
         hidden>
    </div>
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-9 col-xl-8">

            <div class="d-flex justify-content-between
                align-items-center mb-4">

                <div>

                    <h2 class="fw-bold mb-1">
                        Nuevo usuario
                    </h2>

                    <p class="text-muted mb-0">
                        Registre un nuevo usuario en el sistema.
                    </p>

                </div>

            </div>

            <div class="card shadow-sm border">

                <div class="card-body p-4">

                    <form asp-controller="Usuarios" asp-action="Crear" method="post" novalidate data-crear-usuario
                          data-url-validar-datos="@Url.Action("ValidarDatos", "Usuarios")">

                        @Html.AntiForgeryToken()

                        <h5 class="fw-semibold mb-3">
                            Información personal
                        </h5>

                        <div class="row">

                            <div class="col-12 col-md-4 mb-3">

                                <label asp-for="PrimerNombre" class="form-label">
                                </label>

                                <input asp-for="PrimerNombre" class="form-control" autofocus />

                                <span asp-validation-for="PrimerNombre" class="text-danger small">
                                </span>

                            </div>

                            <div class="col-12 col-md-4 mb-3">

                                <label asp-for="SegundoNombre" class="form-label">
                                </label>

                                <input asp-for="SegundoNombre" class="form-control" />

                                <span asp-validation-for="SegundoNombre" class="text-danger small">
                                </span>

                            </div>

                            <div class="col-12 col-md-4 mb-3">

                                <label asp-for="TercerNombre" class="form-label">
                                </label>

                                <input asp-for="TercerNombre" class="form-control" />

                                <span asp-validation-for="TercerNombre" class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-12 col-md-6 mb-3">

                                <label asp-for="PrimerApellido" class="form-label">
                                </label>

                                <input asp-for="PrimerApellido" class="form-control" />

                                <span asp-validation-for="PrimerApellido" class="text-danger small">
                                </span>

                            </div>

                            <div class="col-12 col-md-6 mb-4">

                                <label asp-for="SegundoApellido" class="form-label">
                                </label>

                                <input asp-for="SegundoApellido" class="form-control" />

                                <span asp-validation-for="SegundoApellido" class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <hr class="my-4" />

                        <h5 class="fw-semibold mb-3">
                            Datos de acceso
                        </h5>

                        <div class="row">

                            <div class="col-12 col-md-6 mb-3">

                                <label asp-for="Usuario" class="form-label">
                                </label>

                                <input asp-for="Usuario" class="form-control" autocomplete="off" />

                                <span asp-validation-for="Usuario" class="text-danger small" data-error-usuario>
                                </span>

                            </div>

                            <div class="col-12 col-md-6 mb-3">

                                <label asp-for="Correo" class="form-label">
                                </label>

                                <input asp-for="Correo" class="form-control" autocomplete="off" />

                                <span asp-validation-for="Correo" class="text-danger small" data-error-correo>
                                </span>

                            </div>

                        </div>

                        <div class="row">

                            <div class="col-12 col-md-6 mb-4">

                                <label asp-for="Rol" class="form-label">
                                </label>

                                <select asp-for="Rol" class="form-select">

                                    <option value="">
                                        Seleccione un rol
                                    </option>

                                    @foreach (var rol in rolesDisponibles)
                                    {
                                        <option value="@rol">
                                            @rol
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="Rol" class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <div class="alert alert-info" role="alert">

                            El sistema generará automáticamente una
                            contraseña temporal. El usuario deberá
                            cambiarla en su primer inicio de sesión.

                        </div>

                        <div class="d-flex flex-column
                            flex-sm-row
                            justify-content-end
                            gap-2 mt-4">

                            <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary">

                                Cancelar

                            </a>

                            <button type="submit" class="btn btn-primary">

                                Crear usuario

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}