@model Proyecto_Final.ViewModels.Notificaciones.ResumenNotificaciones

@if (Model.PuedeVer)
{
    <li class="nav-item dropdown">
        <a class="nav-link position-relative" data-bs-toggle="dropdown" href="#" aria-expanded="false"
           aria-label="Notificaciones">
            <i class="bi bi-bell"></i>
            @if (Model.NovedadesNoVisualizadas > 0)
            {
                <span class="navbar-badge badge text-bg-warning">
                    @(Model.NovedadesNoVisualizadas > 99 ? "99+" : Model.NovedadesNoVisualizadas.ToString())
                </span>
            }
        </a>
        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0">
            <span class="dropdown-item dropdown-header">Notificaciones</span>
            <div class="dropdown-divider"></div>
            @if (Model.Notificaciones.Count == 0)
            {
                <div class="dropdown-item text-center text-body-secondary py-3">
                    <i class="bi bi-bell-slash me-1"></i> Sin novedades por mostrar
                </div>
            }
            else
            {
                @foreach (var notificacion in Model.Notificaciones.Take(5))
                {
                    @if (notificacion.Controlador != null && notificacion.Accion != null)
                    {
                        <a asp-controller="@notificacion.Controlador" asp-action="@notificacion.Accion" asp-route-id="@notificacion.Id"
                           class="dropdown-item py-2 text-wrap">
                            <div class="d-flex gap-2">
                                <i class="@notificacion.Icono text-@notificacion.Tipo mt-1"></i>
                                <div class="small flex-grow-1">
                                    <div class="fw-semibold">@notificacion.Titulo</div>
                                    <div class="text-body-secondary">@notificacion.Mensaje</div>
                                    @if (notificacion.Fecha.HasValue)
                                    {
                                        <div class="text-body-secondary mt-1"><i
                                            class="bi bi-clock me-1"></i>@notificacion.Fecha.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                        }
                                    </div>
                                </div>
                            </a>
                        }
                    }
                }
                <div class="dropdown-divider"></div>
                <a asp-controller="Notificaciones" asp-action="Index" class="dropdown-item dropdown-footer">
                    Ver todas las notificaciones
                </a>
            </div>
        </li>
    }
