@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@using Proyecto_Final.Servicios.SeguridadAcademica
@using Proyecto_Final.Servicios.GestionCiclos
@inject IAuthorizationService Autorizacion
@inject IAccesoAcademicoServicio AccesoAcademico
@inject IContextoCicloEscolar ContextoCiclo

@{
    var rolUsuario = User.FindFirst(ClaimTypes.Role)?.Value ?? "Sin rol";
    var puedeConsultarContexto = (await Autorizacion.AuthorizeAsync(
        User,
        Permisos.Alumnos.Ver)).Succeeded;
    var contextoAcademico = await AccesoAcademico.ObtenerContextoUsuarioAsync();
    var esDocente = puedeConsultarContexto && contextoAcademico.DocenteId.HasValue;
    var esAlumno = puedeConsultarContexto && !esDocente && contextoAcademico.AlumnoId.HasValue;
    var cicloSeleccionado = await ContextoCiclo.ObtenerAsync();
    var retornoCiclo = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
}

<nav class="app-header navbar navbar-expand bg-body shadow-sm sticky-top">
    <div class="container-fluid">
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button"
                   aria-label="Mostrar u ocultar menú">
                    <i class="bi bi-list fs-5"></i>
                </a>
            </li>
            <li class="nav-item d-none d-md-block">
                <a asp-controller="Home" asp-action="Index" class="nav-link">Inicio</a>
            </li>
        </ul>

        <ul class="navbar-nav ms-auto align-items-center">
            @if (cicloSeleccionado.Disponible)
            {
                <li class="nav-item dropdown me-2">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-1" href="#"
                       data-bs-toggle="dropdown" aria-expanded="false" aria-label="Cambiar ciclo escolar">
                        <i class="bi bi-calendar3"></i>
                        <span class="d-none d-md-inline">Ciclo escolar:</span>
                        <strong>@cicloSeleccionado.Anio</strong>
                        @if (cicloSeleccionado.EsHistorico)
                        {
                            <span class="badge text-bg-secondary">Histórico</span>
                        }
                        else if (cicloSeleccionado.EsPreparacion)
                        {
                            <span class="badge text-bg-warning">Preparación</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">Activo</span>
                        }
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @foreach (var ciclo in cicloSeleccionado.Opciones)
                        {
                            <li>
                                <form asp-controller="ContextoCiclo" asp-action="Seleccionar" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cicloEscolarId" value="@ciclo.Id" />
                                    <input type="hidden" name="retorno" value="@retornoCiclo" />
                                    <button class="dropdown-item @(ciclo.Id == cicloSeleccionado.CicloEscolarId ? "active" : string.Empty)" type="submit">
                                        @ciclo.Anio — @(ciclo.EsActivo ? "Activo" : ciclo.EsCerrado ? "Cerrado" : "Preparación")
                                    </button>
                                </form>
                            </li>
                        }
                        @if (cicloSeleccionado.EsHistorico)
                        {
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="ContextoCiclo" asp-action="Restablecer" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="retorno" value="@retornoCiclo" />
                                    <button class="dropdown-item" type="submit">Volver al ciclo activo</button>
                                </form>
                            </li>
                        }
                    </ul>
                </li>
            }
            else if (!string.IsNullOrWhiteSpace(cicloSeleccionado.Advertencia))
            {
                <li class="nav-item text-danger small me-2">@cicloSeleccionado.Advertencia</li>
            }
            @await Component.InvokeAsync("Notificaciones")

            <li class="nav-item dropdown user-menu">
                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <span
                        class="user-image rounded-circle shadow-sm bg-primary text-white d-inline-flex align-items-center justify-content-center">
                        <i class="bi bi-person-fill"></i>
                    </span>
                    <span class="d-none d-md-inline">@User.Identity?.Name</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                    <li class="user-header text-bg-primary">
                        <div
                            class="user-avatar-large rounded-circle bg-white text-primary mx-auto mb-2 d-flex align-items-center justify-content-center">
                            <i class="bi bi-person-fill fs-2"></i>
                        </div>
                        <p class="mb-0">@User.Identity?.Name</p>
                        <small>@rolUsuario</small>
                    </li>
                    <li class="user-footer d-flex flex-wrap gap-2 justify-content-between">
                        @if (esAlumno)
                        {
                            <a asp-controller="Alumnos" asp-action="Perfil" class="btn btn-default btn-flat">
                                Mi perfil
                            </a>
                        }
                        else if (esDocente)
                        {
                            <a asp-controller="Docentes" asp-action="Perfil" class="btn btn-default btn-flat">
                                Mi perfil
                            </a>
                        }
                        <a asp-controller="Login" asp-action="CambiarContrasena" class="btn btn-default btn-flat">
                            Cambiar contraseña
                        </a>
                        <form asp-controller="Login" asp-action="CerrarSesion" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-default btn-flat">Cerrar sesión</button>
                        </form>
                    </li>
                </ul>
            </li>
        </ul>
    </div>
</nav>
