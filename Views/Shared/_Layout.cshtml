@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var titulo = ViewData["Title"]?.ToString() ?? "SabIA";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@titulo - SabIA</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc6/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proyecto_Final.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary app-loaded">
    <partial name="_Alertas" />

    <div class="app-wrapper">
        <partial name="_Topbar" />
        <partial name="_Sidebar" />

        <main class="app-main">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-end mb-0">
                                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                                @if (!string.Equals(controladorActual, "Home", StringComparison.OrdinalIgnoreCase))
                                {
                                    <li class="breadcrumb-item active">@titulo</li>
                                }
                            </ol>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-content pb-4">
                @RenderBody()
            </div>
        </main>

        <partial name="_Footer" />
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc6/dist/js/adminlte.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/alertas.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
