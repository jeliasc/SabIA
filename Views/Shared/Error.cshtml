@model Proyecto_Final.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "No fue posible completar la operación";
}

<div class="container-fluid">
    <div class="alert alert-danger" role="alert">
        <h1 class="h4 alert-heading">No fue posible completar la operación</h1>
        <p class="mb-0">Ocurrió un problema inesperado. Intente nuevamente o regrese al inicio.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="app-btn app-btn-primary">Ir al inicio</a>
</div>
