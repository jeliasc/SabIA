@model Proyecto_Final.ViewModels.NavegacionAcademica.EspacioCurso
<div class="row g-4">
    <section class="col-12 col-lg-6">
        <div class="app-card h-100">
            <div class="app-card-header">
                <h3 class="app-card-title">Contenido</h3>
            </div>
            <div class="app-card-body">
                <div class="list-group list-group-flush">@foreach (var enlace in Model.Contenido) {
                    <a
                        asp-controller="@enlace.Controlador" asp-action="@enlace.Accion"
                        asp-route-asignacionId="@Model.Contexto.AsignacionId"
                        class="list-group-item list-group-item-action"><i
                        class="@enlace.Icono me-2"></i>@enlace.Titulo</a>
                    }
                    @if (Model.Contenido.Count == 0)
                    {
                        <span
                        class="text-muted">No hay contenido disponible para sus permisos.</span>
                    }
                </div>
            </div>
        </div>
    </section>
    <section class="col-12 col-lg-6">
        <div class="app-card h-100">
            <div class="app-card-header">
                <h3 class="app-card-title">Aprendizaje</h3>
            </div>
            <div class="app-card-body">
                <div class="list-group list-group-flush">@foreach (var enlace in Model.Aprendizaje) {
                    <a
                        asp-controller="@enlace.Controlador" asp-action="@enlace.Accion"
                        asp-route-asignacionId="@Model.Contexto.AsignacionId"
                        class="list-group-item list-group-item-action"><i
                        class="@enlace.Icono me-2"></i>@enlace.Titulo</a>
                    }
                    @if (Model.Aprendizaje.Count == 0)
                    {
                        <span class="text-muted">No hay actividades disponibles para sus permisos.</span>
                    }
                </div>
            </div>
        </div>
    </section>
</div>
