@model Proyecto_Final.ViewModels.Prototipo.DashboardPrototipo

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">

        <div>
            <h2 class="fw-semibold mb-1">
                Dashboard de coordinación
            </h2>

            <p class="text-body-secondary mb-0">
                Vista inicial para seguimiento académico institucional.
            </p>
        </div>

        <span class="app-badge app-badge-primary align-self-start align-self-lg-center">
            DATOS FICTICIOS
        </span>

    </div>

    <div class="row g-3 mb-4">

        @foreach (var indicador in Model.Indicadores)
        {
            <div class="col-12 col-sm-6 col-xl-3">

                <div class="ui-stat-card @indicador.Clase h-100">

                    <div class="ui-stat-value">
                        @indicador.Valor
                    </div>

                    <p class="ui-stat-label">
                        @indicador.Titulo
                    </p>

                    <i class="ui-stat-icon @indicador.Icono"></i>

                </div>

            </div>
        }

    </div>

    <div class="row g-4">

        <div class="col-12 col-xl-8">

            <div class="app-card h-100">

                <div class="app-card-header">

                    <h3 class="app-card-title">
                        Seguimiento por curso
                    </h3>

                </div>

                <div class="app-card-body p-0">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0 app-table">

                            <thead>
                                <tr>

                                    <th>
                                        Curso
                                    </th>

                                    <th>
                                        Grado / Sección
                                    </th>

                                    <th>
                                        Docente
                                    </th>

                                    <th style="min-width: 180px;">
                                        Progreso
                                    </th>

                                    <th class="text-center">
                                        Pendientes
                                    </th>

                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var curso in Model.Cursos)
                                {
                                    <tr>

                                        <td class="fw-semibold">
                                            @curso.Curso
                                        </td>

                                        <td>
                                            @curso.GradoSeccion
                                        </td>

                                        <td>
                                            @curso.Docente
                                        </td>

                                        <td>

                                            <div class="d-flex align-items-center gap-2">

                                                <div class="ui-progress flex-grow-1">

                                                    <div class="ui-progress-bar"
                                                         style="width: @curso.Progreso%">
                                                    </div>

                                                </div>

                                                <span class="small">
                                                    @curso.Progreso%
                                                </span>

                                            </div>

                                        </td>

                                        <td class="text-center">

                                            <span class="app-badge app-badge-warning">
                                                @curso.EntregasPendientes
                                            </span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-12 col-xl-4">

            <div class="app-card h-100">

                <div class="app-card-header">

                    <h3 class="app-card-title">
                        Alertas de seguimiento
                    </h3>

                </div>

                <div class="app-card-body">

                    <div class="d-grid gap-3">

                        @foreach (var alerta in Model.Alertas)
                        {
                            <div class="app-panel-soft-@alerta.Clase">

                                <div class="fw-semibold">
                                    @alerta.Tipo
                                </div>

                                <div class="small">
                                    @alerta.Mensaje
                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>


        <div class="col-12">

            <div class="app-card">

                <div class="app-card-header">

                    <h3 class="app-card-title">
                        Actividad reciente
                    </h3>

                </div>

                <div class="app-card-body">

                    <div class="row g-3">

                        @foreach (var actividad in Model.ActividadReciente)
                        {
                            <div class="col-12 col-lg-6">

                                <div class="d-flex gap-3 p-3 rounded border h-100">

                                    <div class="app-icon-box app-icon-primary">

                                        <i class="@actividad.Icono"></i>

                                    </div>

                                    <div class="flex-grow-1">

                                        <div class="fw-semibold">
                                            @actividad.Titulo
                                        </div>

                                        <div class="text-body-secondary small">
                                            @actividad.Detalle
                                        </div>

                                    </div>

                                    <div class="text-body-secondary small text-nowrap">
                                        @actividad.Hace
                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>