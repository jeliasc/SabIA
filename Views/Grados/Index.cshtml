@model IEnumerable<Proyecto_Final.ViewModels.Grados.GradoLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService Autorizacion

@{
    ViewData["Title"] = "Grados";

    var crear = (await Autorizacion.AuthorizeAsync(
        User,
        Permisos.Grados.Crear
    )).Succeeded;

    var editar = (await Autorizacion.AuthorizeAsync(
        User,
        Permisos.Grados.Editar
    )).Succeeded;
    var hayAcciones = Model.Any() && editar;
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Grados
            </h2>

            <p class="text-muted mb-0">
                Catálogo de niveles y grados académicos.
            </p>
        </div>

        @if (crear)
        {
            <a asp-action="Crear" class="app-btn app-btn-soft-primary">
                Nuevo grado
            </a>
        }
    </div>

    <div class="card shadow-sm border border-secondary d-none d-md-block">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table app-table w-100" data-tabla-index
                       data-actions-column="@(hayAcciones ? "true" : "false")">
                    <thead>
                        <tr>
                            <th>Nivel</th>
                            <th>Grado</th>
                            <th>Carrera</th>
                            <th class="text-start">Orden</th>
                            <th class="text-start">Secciones (ciclo)</th>
                            <th class="text-start">Asignaciones (ciclo)</th>
                            @if (hayAcciones)
                            {
                                <th class="text-end">Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td>@x.Nivel.GetDisplayName()</td>

                                <td class="fw-semibold">
                                    @x.Nombre
                                </td>

                                <td>@x.Carrera</td>

                                <td class="text-start">@x.Orden</td>

                                <td class="text-start">@x.Secciones</td>

                                <td class="text-start">@x.Asignaciones</td>

                                @if (hayAcciones)
                                {
                                    <td class="text-end">
                                        @if (editar)
                                        {
                                            <a asp-action="Editar" asp-route-id="@x.Id"
                                               class="app-btn app-btn-soft-secondary app-btn-sm">
                                                Editar
                                            </a>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="d-md-none" id="gradosMovil">
    <div class="mb-3">
        <div class="d-grid">
            <button type="button" class="app-btn app-btn-secondary" aria-expanded="false"
                    aria-controls="busqueda-grados-movil" data-mostrar-busqueda-grados>
                <i class="bi bi-search" aria-hidden="true"> </i>
                Buscar grado
            </button>
        </div>
        <div id="busqueda-grados-movil" class="mt-2 d-none" data-contenedor-busqueda-grados>
            <input type="search" id="buscarGradoMovil" class="form-control"
                   placeholder="Nivel, grado, carrera u orden..." aria-label="Buscar grados" autocomplete="off" />
        </div>
    </div>
    <div data-lista-grados-movil>
        @foreach (var x in Model)
        {
            <article class="card shadow-sm border-0 mb-3 grado-movil-item"
                     data-busqueda="@($"{x.Nivel.GetDisplayName()} {x.Nombre} {x.Carrera} {x.Orden} {x.Secciones} {x.Asignaciones}")">
                <div class="card-body">
                    <div class="fw-bold">@x.Nombre</div>
                    <div class="text-muted mb-3">@x.Nivel.GetDisplayName() · @x.Carrera</div>
                    <div class="row g-2 mb-3">
                        <div class="col-4"><span class="small text-muted d-block">Orden</span>@x.Orden</div>
                        <div class="col-4"><span class="small text-muted d-block">Secciones</span>@x.Secciones</div>
                        <div class="col-4"><span class="small text-muted d-block">Asignaciones</span>@x.Asignaciones</div>
                    </div>
                    @if (editar)
                    {
                        <a asp-action="Editar" asp-route-id="@x.Id" class="app-btn app-btn-soft-secondary w-100">Editar</a>
                    }
                </div>
            </article>
        }
    </div>
    <p class="text-muted text-center py-3 d-none" data-sin-grados-movil>No se encontraron grados.</p>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span class="small text-muted" data-contador-grados-movil> </span>
        <div class="d-flex gap-2">
            <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm" data-anterior-grados-movil>
                Anterior
            </button>
            <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm" data-siguiente-grados-movil>
                Siguiente
            </button>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/grados-index.js" asp-append-version="true"></script>
}
