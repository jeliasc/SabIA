@model IEnumerable<Proyecto_Final.ViewModels.Grados.GradoLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService Autorizacion

@{
    ViewData["Title"] = "Grados";

    var crear = (await Autorizacion.AuthorizeAsync(
        User,
        Permisos.Grados.Crear
    )).Succeeded;

    var editar = (await Autorizacion.AuthorizeAsync(
        User,
        Permisos.Grados.Editar
    )).Succeeded;
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Grados
            </h2>

            <p class="text-muted mb-0">
                Catálogo de niveles y grados académicos.
            </p>
        </div>

        @if (crear)
        {
            <a asp-action="Crear" class="app-btn app-btn-soft-primary">
                Nuevo grado
            </a>
        }
    </div>

    <div class="card shadow-sm border border-secondary">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table app-table w-100" data-tabla-index data-actions-column="true">
                    <thead>
                        <tr>
                            <th>Nivel</th>
                            <th>Grado</th>
                            <th>Carrera</th>
                            <th>Orden</th>
                            <th>Secciones</th>
                            <th>Cursos</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td>@x.Nivel</td>

                                <td class="fw-semibold">
                                    @x.Nombre
                                </td>

                                <td>@x.Carrera</td>

                                <td>@x.Orden</td>

                                <td>@x.Secciones</td>

                                <td>@x.Cursos</td>

                                <td class="text-end">
                                    @if (editar)
                                    {
                                        <a asp-action="Editar" asp-route-id="@x.Id"
                                           class="app-btn app-btn-soft-secondary app-btn-sm">
                                            Editar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
