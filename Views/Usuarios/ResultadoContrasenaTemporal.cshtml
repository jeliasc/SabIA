@model Proyecto_Final.ViewModels.Usuarios.ResultadoContrasenaTemporal

@{
    var tipoOperacion =
        ViewData["TipoOperacion"] as string;

    var esCreacion =
        tipoOperacion == "Creacion";

    ViewData["Title"] =
        esCreacion
            ? "Usuario creado"
            : "Contraseña temporal";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-12 col-md-8 col-lg-6">

            <div class="app-card">

                <div class="app-card-body p-4">

                    <div class="text-center mb-4">

                        <div class="app-icon-box app-icon-success mx-auto mb-3">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <h2 class="fw-bold mb-2">
                            @(esCreacion
                                ? "Usuario creado correctamente"
                                : "Contraseña restablecida")
                        </h2>

                        <p class="text-muted mb-0">
                            @(esCreacion
                                ? "La cuenta y la contraseña temporal fueron generadas correctamente."
                                : "La contraseña temporal fue generada correctamente.")
                        </p>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Usuario
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.Usuario"
                               readonly />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Nombre
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.NombreCompleto"
                               readonly />

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Contraseña temporal
                        </label>

                        <div class="input-group">

                            <input type="text"
                                   id="contrasenaTemporal"
                                   class="form-control fw-bold"
                                   value="@Model.ContrasenaTemporal"
                                   readonly />

                            <button type="button"
                                    class="app-btn app-btn-soft-secondary"
                                    id="botonCopiarContrasena">
                                <i class="bi bi-copy"></i>
                                Copiar
                            </button>

                        </div>

                    </div>

                    <div class="app-alert app-alert-warning mb-3">

                        <i class="bi bi-exclamation-triangle"></i>

                        <div>
                            @if (esCreacion)
                            {
                                <span>
                                    Las credenciales fueron enviadas al correo
                                    registrado. Esta contraseña temporal también
                                    se muestra aquí como respaldo.
                                </span>
                            }
                            else
                            {
                                <span>
                                    Esta contraseña se mostrará únicamente en esta
                                    pantalla. Entréguela al usuario por un medio seguro.
                                </span>
                            }
                        </div>

                    </div>

                    <div class="app-alert app-alert-info">

                        <i class="bi bi-info-circle"></i>

                        <div>
                            @if (esCreacion)
                            {
                                <span>
                                    El usuario deberá cambiar esta contraseña
                                    en su primer inicio de sesión.
                                </span>
                            }
                            else
                            {
                                <span>
                                    El usuario deberá cambiar esta contraseña
                                    al iniciar sesión nuevamente.
                                </span>
                            }
                        </div>

                    </div>

                    <div class="d-grid mt-4">

                        <a asp-controller="Usuarios"
                           asp-action="Index"
                           class="app-btn app-btn-soft-primary">
                            <i class="bi bi-arrow-left"></i>
                            Volver a usuarios
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
}