@model IEnumerable<Proyecto_Final.Models.Usuario>

@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad

@inject IAuthorizationService Autorizacion

@{
    ViewData["Title"] = "Usuarios";

    // PERMISO USUARIOS - VER
    bool permisoUsuariosVer =
        (await Autorizacion.AuthorizeAsync(
            User,
             "Usuarios.Ver"
        )).Succeeded;

    // PERMISO USUARIOS - CREAR
    var permisoUsuariosCrear =
        (await Autorizacion.AuthorizeAsync(
            User,
                "Usuarios.Crear"
        )).Succeeded;

    // PERMISO USUARIOS - EDITAR
    var permisoUsuariosEditar =
        (await Autorizacion.AuthorizeAsync(
            User,
            Permisos.Usuarios.Editar
        )).Succeeded;

    // PERMISO USUARIOS - CAMBIAR ESTADO
    var permisoUsuariosCambiarEstado =
        (await Autorizacion.AuthorizeAsync(
            User,
            Permisos.Usuarios.CambiarEstado
        )).Succeeded;

    // PERMISO USUARIOS - RESTABLECER CONTRASEÑA
    var permisoUsuariosRestablecerContrasena =
        (await Autorizacion.AuthorizeAsync(
            User,
            Permisos.Usuarios.RestablecerContrasena
        )).Succeeded;
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />
    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Usuarios
            </h2>

            <p class="text-muted mb-0">
                Administración de usuarios del sistema.
            </p>

        </div>

        @if (permisoUsuariosCrear)
        {
            <div class="d-grid d-md-block">

                <a asp-controller="Usuarios" asp-action="Crear" class="app-btn app-btn-soft-primary">

                    Nuevo usuario

                </a>

            </div>
        }

    </div>


    @* BÚSQUEDA - VISTA MÓVIL *@
    <div class="d-md-none mb-3">

        <div class="d-grid">

            <button type="button" class="app-btn app-btn-secondary" data-mostrar-busqueda-usuarios>
                <i class="bi bi-search"></i>
                Buscar usuario
            </button>

        </div>

        <div class="mt-2 d-none" data-contenedor-busqueda-usuarios>

            <input type="search" class="form-control" placeholder="Buscar por usuario, nombre o correo..."
                   autocomplete="off" data-busqueda-usuarios />

        </div>

    </div>


    @* VISTA DE ESCRITORIO *@
    <div class="card shadow-sm border border-secondary d-none d-md-block">

        <div class="card-body">

            <div class="table-responsive">

                <table id="tablaUsuarios" class="table app-table w-100" data-tabla-index data-actions-column="true"
                       data-search-placeholder="Usuario, nombre o correo..."
                       data-empty-message="No existen usuarios registrados" data-zero-message="No se encontraron usuarios">

                    <thead>

                        <tr>

                            <th>
                                Usuario
                            </th>

                            <th>
                                Nombre
                            </th>

                            <th>
                                Correo
                            </th>

                            <th>
                                Estado
                            </th>

                            <th>
                                Cambio de contraseña
                            </th>

                            <th class="text-end">
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var usuario in Model)
                        {
                            var nombreCompleto = string.Join(
                                " ",
                                new[]
                                {
                                    usuario.PrimerNombre,
                                    usuario.SegundoNombre,
                                    usuario.TercerNombre,
                                    usuario.PrimerApellido,
                                    usuario.SegundoApellido
                                }
                                .Where(nombre =>
                                    !string.IsNullOrWhiteSpace(nombre))
                            );

                            <tr>

                                <td>
                                    @usuario.UserName
                                </td>

                                <td>
                                    @nombreCompleto
                                </td>

                                <td>
                                    @usuario.Email
                                </td>

                                <td>

                                    @if (usuario.Activo)
                                    {
                                        <span class="app-badge app-badge-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="app-badge app-badge-danger">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (usuario.CambiarContrasena)
                                    {
                                        <span class="app-badge app-badge-warning">
                                            Pendiente
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="app-badge app-badge-success">
                                            Actualizada
                                        </span>
                                    }

                                </td>

                                <td class="app-actions-cell">

                                    <div class="app-actions app-actions-table">

                                        @if (permisoUsuariosVer)
                                        {
                                            <a asp-controller="Usuarios" asp-action="Ver" asp-route-id="@usuario.Id"
                                               class="app-btn-icon" title="Ver">

                                                <i class="bi bi-eye"></i>

                                            </a>
                                        }

                                        @if (permisoUsuariosEditar)
                                        {
                                            <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@usuario.Id"
                                               class="app-btn app-btn-soft-secondary app-btn-sm">

                                                Editar

                                            </a>
                                        }

                                        @if (permisoUsuariosCambiarEstado)
                                        {
                                            if (usuario.Activo)
                                            {
                                                <form asp-controller="Usuarios" asp-action="Desactivar" asp-route-id="@usuario.Id"
                                                      method="post" class="m-0" data-cambiar-estado-usuario data-accion="desactivar">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit" class="app-btn app-btn-soft-danger app-btn-sm">

                                                        Desactivar

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Usuarios" asp-action="Activar" asp-route-id="@usuario.Id"
                                                      method="post" class="m-0" data-cambiar-estado-usuario data-accion="activar">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit" class="app-btn app-btn-soft-success app-btn-sm">

                                                        Activar

                                                    </button>

                                                </form>
                                            }
                                        }

                                        @if (permisoUsuariosRestablecerContrasena &&
     usuario.Activo)
                                        {
                                            <div class="app-actions">

                                                <form asp-controller="Usuarios" asp-action="EnviarRestablecimientoContrasena"
                                                      asp-route-id="@usuario.Id" method="post" class="m-0"
                                                      data-restablecer-contrasena-correo>

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="app-btn app-btn-soft-warning app-btn-sm app-btn-two-lines app-btn-reset">

                                                        <span>Enviar enlace</span>
                                                        <span>por correo</span>

                                                    </button>

                                                </form>


                                                <form asp-controller="Usuarios" asp-action="RestablecerContrasenaManual"
                                                      asp-route-id="@usuario.Id" method="post" class="m-0"
                                                      data-restablecer-contrasena-manual>

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="app-btn app-btn-soft-secondary app-btn-sm app-btn-two-lines app-btn-reset">

                                                        <span>Generar contraseña</span>
                                                        <span>temporal</span>

                                                    </button>

                                                </form>

                                            </div>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    @* VISTA MÓVIL *@
    <div class="d-md-none" data-contenedor-usuarios-movil>

        @foreach (var usuario in Model)
        {
            var nombreCompleto = string.Join(
                " ",
                new[]
                {
                    usuario.PrimerNombre,
                    usuario.SegundoNombre,
                    usuario.TercerNombre,
                    usuario.PrimerApellido,
                    usuario.SegundoApellido
                }
                .Where(nombre =>
                    !string.IsNullOrWhiteSpace(nombre))
            );

            var textoBusqueda =
                $"{usuario.UserName} {nombreCompleto} {usuario.Email}";

            <div class="card shadow-sm border-0 mb-3" data-usuario data-texto-busqueda="@textoBusqueda">

                <div class="card-body p-4">

                    <div class="d-flex
                        justify-content-between
                        align-items-start
                        gap-2
                        mb-3">

                        <div>

                            <div class="fw-bold fs-5">
                                @usuario.UserName
                            </div>

                            <div class="text-muted small">
                                @nombreCompleto
                            </div>

                        </div>

                        @if (usuario.Activo)
                        {
                            <span class="app-badge app-badge-success">
                                Activo
                            </span>
                        }
                        else
                        {
                            <span class="app-badge app-badge-danger">
                                Inactivo
                            </span>
                        }

                    </div>


                    <div class="small text-muted mb-1">
                        Correo electrónico
                    </div>

                    <div class="text-break mb-3">
                        @usuario.Email
                    </div>


                    <div class="d-flex align-items-center gap-2 mb-4">

                        <span class="app-text-muted small">
                            Contraseña:
                        </span>

                        @if (usuario.CambiarContrasena)
                        {
                            <span class="app-badge app-badge-warning">
                                Pendiente
                            </span>
                        }
                        else
                        {
                            <span class="app-badge app-badge-success">
                                Actualizada
                            </span>
                        }

                    </div>

                    <div class="d-grid gap-2">

                        @if (permisoUsuariosVer)
                        {
                            <a asp-controller="Usuarios" asp-action="Ver" asp-route-id="@usuario.Id"
                               class="app-btn app-btn-soft-secondary app-btn-sm">

                                <i class="bi bi-eye"></i>
                                Ver

                            </a>
                        }

                        @if (permisoUsuariosEditar)
                        {
                            <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@usuario.Id"
                               class="app-btn app-btn-soft-primary app-btn-sm">

                                <i class="bi bi-pencil"></i>
                                Editar

                            </a>
                        }

                        @if (permisoUsuariosCambiarEstado)
                        {
                            if (usuario.Activo)
                            {
                                <form asp-controller="Usuarios" asp-action="Desactivar" asp-route-id="@usuario.Id" method="post"
                                      class="m-0" data-cambiar-estado-usuario data-accion="desactivar">

                                    @Html.AntiForgeryToken()

                                    <div class="d-grid">

                                        <button type="submit" class="app-btn app-btn-soft-danger app-btn-sm">

                                            <i class="bi bi-person-x"></i>
                                            Desactivar

                                        </button>

                                    </div>

                                </form>
                            }
                            else
                            {
                                <form asp-controller="Usuarios" asp-action="Activar" asp-route-id="@usuario.Id" method="post"
                                      class="m-0" data-cambiar-estado-usuario data-accion="activar">

                                    @Html.AntiForgeryToken()

                                    <div class="d-grid">

                                        <button type="submit" class="app-btn app-btn-soft-success app-btn-sm">

                                            <i class="bi bi-person-check"></i>
                                            Activar

                                        </button>

                                    </div>

                                </form>
                            }
                        }

                        @if (permisoUsuariosRestablecerContrasena &&
                            usuario.Activo)
                        {
                            <div class="d-grid gap-2">

                                <form asp-controller="Usuarios" asp-action="EnviarRestablecimientoContrasena"
                                      asp-route-id="@usuario.Id" method="post" class="m-0" data-restablecer-contrasena-correo>

                                    @Html.AntiForgeryToken()

                                    <div class="d-grid">

                                        <button type="submit" class="app-btn app-btn-soft-warning app-btn-sm app-btn-reset">
                                            <i class="bi bi-envelope"></i>
                                            Enviar enlace por correo
                                        </button>

                                    </div>

                                </form>

                                <form asp-controller="Usuarios" asp-action="RestablecerContrasenaManual"
                                      asp-route-id="@usuario.Id" method="post" class="m-0" data-restablecer-contrasena-manual>

                                    @Html.AntiForgeryToken()

                                    <div class="d-grid">

                                        <button type="submit" class="app-btn app-btn-soft-secondary app-btn-sm app-btn-reset">
                                            <i class="bi bi-key"></i>
                                            Generar contraseña temporal
                                        </button>

                                    </div>

                                </form>

                            </div>
                        }

                    </div>
                </div>

            </div>
        }

    </div>

    @* SIN RESULTADOS - BÚSQUEDA MÓVIL *@
    <div class="d-md-none
        text-center
        text-muted
        py-4
        d-none" data-sin-resultados-usuarios>

        No se encontraron usuarios.

    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-4">

            No existen usuarios registrados.

        </div>
    }

</div>

@section Scripts {
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
}
