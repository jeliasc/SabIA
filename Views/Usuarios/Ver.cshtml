@model Proyecto_Final.ViewModels.Usuarios.DetalleUsuario

@{
    ViewData["Title"] = "Ver usuario";
}

<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="mb-4">
                <h2 class="fw-bold mb-1">
                    Detalle de usuario
                </h2>

                <p class="text-muted mb-0">
                    Información registrada del usuario.
                </p>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    @* INFORMACIÓN PERSONAL *@
                    <h5 class="fw-bold mb-3">
                        Información personal
                    </h5>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">
                                Primer nombre
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.PrimerNombre"
                                   readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Segundo nombre
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@(Model.SegundoNombre ?? "-")"
                                   readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Tercer nombre
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@(Model.TercerNombre ?? "-")"
                                   readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Primer apellido
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.PrimerApellido"
                                   readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Segundo apellido
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@(Model.SegundoApellido ?? "-")"
                                   readonly />
                        </div>

                    </div>

                    <hr class="my-4" />

                    @* DATOS DE ACCESO *@
                    <h5 class="fw-bold mb-3">
                        Datos de acceso
                    </h5>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label">
                                Usuario
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.Usuario"
                                   readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Correo electrónico
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.Correo"
                                   readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Rol
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.Rol"
                                   readonly />
                        </div>

                    </div>

                    <hr class="my-4" />

                    @* ESTADO DE LA CUENTA *@
                    <h5 class="fw-bold mb-3">
                        Estado de la cuenta
                    </h5>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label class="form-label d-block">
                                Estado
                            </label>

                            @if (Model.Activo)
                            {
                                <span class="app-badge app-badge-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="app-badge app-badge-danger">
                                    Inactivo
                                </span>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label d-block">
                                Cambio de contraseña
                            </label>

                            @if (Model.CambiarContrasena)
                            {
                                <span class="app-badge app-badge-warning">
                                    Pendiente
                                </span>
                            }
                            else
                            {
                                <span class="app-badge app-badge-success">
                                    Actualizada
                                </span>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Fecha de creación
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")"
                                   readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Último cambio de contraseña
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@(Model.FechaUltimoCambioContrasena?.ToString("dd/MM/yyyy HH:mm") ?? "Sin registro")"
                                   readonly />
                        </div>

                    </div>

                    @* ACCIONES *@
                    <div class="d-flex justify-content-end mt-4">

                        <a asp-controller="Usuarios"
                           asp-action="Index"
                           class="app-btn app-btn-soft-primary">
                            Regresar
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>

</div>