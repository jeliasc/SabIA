@model Proyecto_Final.ViewModels.ExploradorAcademico.ExploradorAcademicoIndice
@{
    ViewData["Title"] = "Explorador académico";
}
<div class="container-fluid">
    <partial name="_AlertasResultado" />
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item active">Explorador académico</li>
                </ol>
            </nav>
            <h2 class="fw-semibold mb-1">Ciclo @Model.Contexto.Anio</h2>
            <p class="text-body-secondary mb-0">@Model.Contexto.Estado. Seleccione un grado para consultar sus
                secciones.</p>
            </div>
            @if (Model.Contexto.EsHistorico)
            {
                <span class="app-badge app-badge-secondary">Modo de consulta</span>
            }
            else
            {

                <span class="app-badge app-badge-success">Ciclo activo institucional</span>
            }
        </div>
        @if (Model.Carreras.Count == 0)
        {
            <div class="alert alert-info" role="status">No hay grados o secciones configurados para este ciclo.</div>
        }
        @foreach (var carrera in Model.Carreras)
        {
            <section class="app-card mb-4" aria-label="@carrera.Nombre">
                <div class="app-card-header">
                    <h3 class="app-card-title">@carrera.Nombre</h3>
                </div>
                <div class="app-card-body">
                    <div class="row g-3">
                        @foreach (var grado in carrera.Grados)
                        {
                            <div class="col-12 col-md-6 col-xl-4"><a asp-action="Grado" asp-route-id="@grado.Id"
                                                                     class="app-card h-100 d-block text-decoration-none text-body border">
                                <div class="app-card-body"><i class="bi bi-layers fs-3 text-primary"></i>
                                    <div class="fw-semibold mt-2">@grado.Nombre</div>
                                    <div class="small text-body-secondary">@grado.Nivel · @grado.Secciones sección(es)</div>
                                </div>
                            </a></div>
                        }
                    </div>
                </div>
            </section>
        }
    </div>
