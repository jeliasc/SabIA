@model Proyecto_Final.ViewModels.ExploradorAcademico.ExploradorCursoAcademico
@{ ViewData["Title"] = "Curso académico"; }
<div class="container-fluid">
    <div class="mb-4">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index">Ciclo @Model.Contexto.Anio</a></li><li class="breadcrumb-item"><a asp-action="Grado" asp-route-id="@Model.GradoId">@Model.Grado</a></li><li class="breadcrumb-item"><a asp-action="Seccion" asp-route-id="@Model.SeccionId">Sección @Model.Seccion</a></li><li class="breadcrumb-item active">@Model.Curso</li></ol></nav>
        <h2 class="fw-semibold mb-1">@Model.Contexto.Anio / @Model.Grado / @Model.Seccion / @Model.Curso</h2>
        <p class="text-body-secondary mb-0">Docente: @Model.Docente · @Model.Contexto.Estado</p>
    </div>
    <section class="row g-3 mb-4" aria-label="Resumen del curso">
        <div class="col-6 col-lg-3"><div class="ui-stat-card ui-stat-card-primary h-100"><div class="ui-stat-value">@Model.Unidades</div><p class="ui-stat-label">Unidades</p></div></div>
        <div class="col-6 col-lg-3"><div class="ui-stat-card ui-stat-card-info h-100"><div class="ui-stat-value">@Model.Tareas</div><p class="ui-stat-label">Tareas</p></div></div>
        <div class="col-6 col-lg-3"><div class="ui-stat-card ui-stat-card-warning h-100"><div class="ui-stat-value">@Model.Cuestionarios</div><p class="ui-stat-label">Cuestionarios</p></div></div>
        <div class="col-6 col-lg-3"><div class="ui-stat-card ui-stat-card-success h-100"><div class="ui-stat-value">@Model.Entregas</div><p class="ui-stat-label">Entregas</p></div></div>
    </section>
    <div class="row g-4"><div class="col-12 col-lg-6"><section class="app-card h-100"><div class="app-card-header"><h3 class="app-card-title">Contenido</h3></div><div class="app-card-body">@if (Model.Contenido.Count == 0) { <p class="text-body-secondary mb-0">No hay contenido visible para sus permisos.</p> } else { <div class="list-group list-group-flush">@foreach (var item in Model.Contenido) { <div class="list-group-item"><div class="fw-semibold">@item.Titulo</div><div class="small text-body-secondary">@item.Detalle</div></div> }</div> }</div></section></div><div class="col-12 col-lg-6"><section class="app-card h-100"><div class="app-card-header"><h3 class="app-card-title">Aprendizaje</h3></div><div class="app-card-body">@if (Model.Aprendizaje.Count == 0) { <p class="text-body-secondary mb-0">No hay actividades visibles para sus permisos.</p> } else { <div class="list-group list-group-flush">@foreach (var item in Model.Aprendizaje) { <div class="list-group-item"><div class="fw-semibold">@item.Titulo</div><div class="small text-body-secondary">@item.Detalle</div></div> }</div> }</div></section></div></div>
    @if (Model.Accesos.Count > 0) { <section class="mt-4"><h3 class="h5 mb-3">Abrir módulo</h3><div class="row g-3">@foreach (var acceso in Model.Accesos) { <div class="col-6 col-md-4 col-xl-2">@if (acceso.Controlador == "Calificaciones") { <a asp-controller="Calificaciones" asp-action="ControlTareas" asp-route-asignacionId="@Model.AsignacionId" class="app-card h-100 d-block text-decoration-none text-body"><div class="app-card-body"><i class="@acceso.Icono fs-4 text-primary"></i><div class="small fw-semibold mt-2">@acceso.Titulo</div></div></a> } else { <a asp-controller="@acceso.Controlador" asp-action="Index" asp-route-asignacionId="@Model.AsignacionId" class="app-card h-100 d-block text-decoration-none text-body"><div class="app-card-body"><i class="@acceso.Icono fs-4 text-primary"></i><div class="small fw-semibold mt-2">@acceso.Titulo</div></div></a> }</div> }</div></section> }
</div>
