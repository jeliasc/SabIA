@model IEnumerable<Proyecto_Final.ViewModels.Unidades.UnidadLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService A

@{
    ViewData["Title"] = "Unidades";

    var c = (await A.AuthorizeAsync(
        User,
        Permisos.Unidades.Crear
    )).Succeeded;

    var e = (await A.AuthorizeAsync(
        User,
        Permisos.Unidades.Editar
    )).Succeeded;

    var p = (await A.AuthorizeAsync(
        User,
        Permisos.Unidades.Publicar
    )).Succeeded;
    var soloLectura = ViewData["SoloLectura"] as bool? ?? false;
    var hayAcciones = !soloLectura && Model.Any() && (e || p);
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Unidades
            </h2>

            <p class="text-muted mb-0">
                Organización y liberación progresiva del contenido académico.
            </p>
        </div>
        <div class="d-grid d-md-flex align-items-center gap-2">
            @if (!soloLectura && c)
            {
                <a asp-action="Crear" class="app-btn app-btn-soft-primary">
                    Nueva unidad
                </a>
            }
            <a asp-action="@(soloLectura ? "Index" : "Historial")" class="app-btn app-btn-soft-secondary">
                @(soloLectura ? "Ver vigentes" : "Ver historial")
            </a>
        </div>
    </div>

    <div class="card shadow-sm border border-secondary d-none d-md-block">
        <div class="card-body">
            <table class="table app-table w-100" data-tabla-index
                   data-actions-column="@(hayAcciones ? "true" : "false")">
                <thead>
                    <tr>
                        <th class="text-start">Orden</th>
                        <th>Unidad</th>
                        <th>Curso</th>
                        <th>Sección</th>
                        <th class="text-start">Materiales</th>
                        <th>Estado</th>
                        @if (hayAcciones)
                        {
                            <th>Acciones</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td class="text-start">@x.Orden</td>

                            <td class="fw-semibold">
                                @x.Titulo
                            </td>

                            <td>@x.Curso</td>

                            <td>@x.Seccion</td>

                            <td class="text-start">@x.Materiales</td>

                            <td>
                                <span class="app-badge @(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada
                                          ? "app-badge-success"
                                          : "app-badge-secondary")">
                                    @x.Estado.GetDisplayName()
                                </span>
                            </td>

                            @if (hayAcciones)
                            {
                                <td>
                                    <div class="app-actions app-actions-table">
                                        @if (e)
                                        {
                                            <a asp-action="Editar" asp-route-id="@x.UnidadAsignacionId"
                                               class="app-btn app-btn-soft-secondary app-btn-sm">
                                                Editar
                                            </a>
                                        }

                                        @if (p)
                                        {
                                            <form asp-action="@(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada
                                                  ? "Ocultar"
                                                  : "Publicar")" asp-route-id="@x.UnidadAsignacionId" method="post"
                                                  data-confirmar-accion-academica
                                                  data-confirmar-titulo="@(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada ? "Ocultar unidad" : "Publicar unidad")"
                                                  data-confirmar-mensaje="@(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada ? "La unidad dejará de estar disponible para los alumnos." : "La unidad quedará disponible para los alumnos autorizados.")"
                                                  data-confirmar-texto="@(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada ? "Ocultar" : "Publicar")"
                                                  data-confirmar-color="@(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada ? "#dc3545" : "#198754")">
                                                @Html.AntiForgeryToken()

                                                <button class="app-btn @(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada
                                                        ? "app-btn-soft-danger"
                                                        : "app-btn-soft-success") app-btn-sm">
                                                    @(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada
                                                        ? "Ocultar"
                                                        : "Publicar")
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-md-none" id="unidadesMovil">
    <div class="mb-3">
        <div class="d-grid">
            <button type="button" class="app-btn app-btn-secondary" aria-expanded="false"
                    aria-controls="busqueda-unidades-movil" data-mostrar-busqueda-unidades>
                <i class="bi bi-search" aria-hidden="true"></i>
                Buscar unidad
            </button>
        </div>

        <div id="busqueda-unidades-movil" class="mt-2 d-none" data-contenedor-busqueda-unidades>
            <input type="search" id="buscarUnidadMovil" class="form-control"
                   placeholder="Unidad, curso, sección, estado u orden..." aria-label="Buscar unidades"
                   autocomplete="off" />
        </div>
    </div>

    <div id="listaUnidadesMovil">
        @foreach (var x in Model)
        {
            <div class="card border-0 shadow-sm mb-3 unidad-movil-item"
                 data-busqueda="@($"{x.Orden} {x.Titulo} {x.Curso} {x.Seccion} {x.Materiales} {x.Estado.GetDisplayName()}".ToLowerInvariant())">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-2">
                        <div class="fw-bold">
                            @x.Orden. @x.Titulo
                        </div>

                        <span class="app-badge @(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada
                              ? "app-badge-success"
                              : "app-badge-secondary")">
                            @x.Estado.GetDisplayName()
                        </span>
                    </div>

                    <div class="text-muted mb-2">
                        @x.Curso · @x.Seccion
                    </div>

                    <div class="mb-3">
                        <span class="text-muted">Materiales:</span>
                        <span class="fw-medium">@x.Materiales</span>
                    </div>

                    @if (!soloLectura && e)
                    {
                        <a asp-action="Editar" asp-route-id="@x.UnidadAsignacionId"
                           class="app-btn app-btn-soft-secondary w-100 mb-2">
                            Editar
                        </a>
                    }

                    @if (!soloLectura && p)
                    {
                        <form asp-action="@(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada
                              ? "Ocultar"
                              : "Publicar")" asp-route-id="@x.UnidadAsignacionId" method="post"
                              data-confirmar-accion-academica
                              data-confirmar-titulo="@(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada ? "Ocultar unidad" : "Publicar unidad")"
                              data-confirmar-mensaje="@(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada ? "La unidad dejará de estar disponible para los alumnos." : "La unidad quedará disponible para los alumnos autorizados.")"
                              data-confirmar-texto="@(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada ? "Ocultar" : "Publicar")"
                              data-confirmar-color="@(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada ? "#dc3545" : "#198754")">
                            @Html.AntiForgeryToken()

                            <button class="app-btn @(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada
                                    ? "app-btn-soft-danger"
                                    : "app-btn-soft-success") w-100">
                                @(x.Estado == Proyecto_Final.Models.EstadoPublicacionUnidad.Publicada
                                    ? "Ocultar"
                                    : "Publicar")
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>

</div>

<p id="sinUnidadesMovil" class="text-muted text-center py-3 d-none">
    No se encontraron unidades.
</p>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <span id="contadorUnidadesMovil" class="small text-muted"></span>

    <div class="d-flex gap-2">
        <button type="button" id="anteriorUnidadesMovil" class="app-btn app-btn-soft-secondary app-btn-sm">
            Anterior
        </button>

        <button type="button" id="siguienteUnidadesMovil" class="app-btn app-btn-soft-secondary app-btn-sm">
            Siguiente
        </button>
    </div>
</div>

@section Scripts
{
    <script src="~/js/acciones-academicas.js" asp-append-version="true"></script>
    <script src="~/js/unidades-index.js" asp-append-version="true"></script>
}
