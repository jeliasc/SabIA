@model Proyecto_Final.ViewModels.Unidades.FormularioUnidad

@{
    var edicion = Model as Proyecto_Final.ViewModels.Unidades.EditarUnidad;
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3">
</div>

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="AsignacionId" class="form-label">
            Asignación
        </label>

        <select asp-for="AsignacionId" class="form-select" data-select-busqueda>
            <option value="">Seleccione...</option>

            @foreach (var x in Model.Asignaciones)
            {
                <option value="@x.Id">
                    @x.Texto
                </option>
            }
        </select>
    </div>

    <div class="col-md-4">
        <label asp-for="PeriodoId" class="form-label">
            Período
        </label>

        <select asp-for="PeriodoId" class="form-select" data-select-busqueda>
            <option value="">Sin período específico</option>

            @foreach (var x in Model.Periodos)
            {
                <option value="@x.Id">
                    @x.Texto
                </option>
            }
        </select>
    </div>

    <div class="col-12">
        <label asp-for="Titulo" class="form-label">
            Título
        </label>

        <input asp-for="Titulo" class="form-control" />
    </div>

    <div class="col-12">
        <div class="app-alert app-alert-info mb-0">
            @if (edicion is null)
            {
                <span>El orden se asignará automáticamente dentro de la asignación seleccionada.</span>
            }
            else
            {
                <span>Orden actual: <strong>@edicion.Orden</strong>. Solo cambiará automáticamente si selecciona otra asignación.</span>
            }
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label">
            Descripción
        </label>

        <textarea asp-for="Descripcion" class="form-control" rows="3">
        </textarea>
    </div>

    <div class="col-md-6">
        <label asp-for="FechaDisponibilidad" class="form-label">
            Disponible desde
        </label>

        <input asp-for="FechaDisponibilidad" type="datetime-local" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="FechaCierreAcceso" class="form-label">
            Cierre de acceso
        </label>

        <input asp-for="FechaCierreAcceso" type="datetime-local" class="form-control" />
    </div>
</div>
