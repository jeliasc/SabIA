@model Proyecto_Final.ViewModels.Entregas.CalificarEntrega
@using System.Globalization

@{
    ViewData["Title"] = "Calificar entrega";
    var punteoMaximo = Model.PunteoMaximo.ToString("0.00", CultureInfo.InvariantCulture);
}

<div class="container-fluid">
    <h2 class="fw-bold mb-1">
        Calificar entrega
    </h2>

    <p class="text-muted mb-4">
        @Model.Alumno · @Model.Tarea
    </p>

    <div class="mb-3">
        <a asp-action="Detalle" asp-route-id="@Model.Id" class="app-btn app-btn-soft-secondary app-btn-sm">
            Ver y seleccionar otro intento
        </a>
    </div>

    @if (Model.Intentos.Count > 1)
    {
        <div class="mb-3">
            <label class="form-label" for="selector-intento-calificar">Seleccionar intento</label>
            <select id="selector-intento-calificar" class="form-select">
                @foreach (var intento in Model.Intentos)
                {
                    <option value="@Url.Action("Calificar", "Entregas", new { id = intento.Id })"
                            selected="@(intento.Id == Model.Id)">
                        Intento @intento.NumeroEnvio — @(intento.FechaEntrega?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ??
                                                                                                        "Pendiente")
                    </option>
                }
            </select>
        </div>
    }

    <div class="app-alert app-alert-info mb-4">
        Esta calificación es de apoyo y no sustituye el sistema oficial de notas de la institución.
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <input asp-for="PunteoMaximo" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Calificacion" class="form-label">
                        Calificación (máximo @Model.PunteoMaximo)
                    </label>

                    <input asp-for="Calificacion" class="form-control"
                           type="number" min="0"
                           max="@punteoMaximo"
                           step="0.01" inputmode="decimal"
                           data-val="true"
                           data-val-number="Ingrese una calificación válida."
                           data-val-range="La calificación debe estar entre 0 y @punteoMaximo."
                           data-val-range-min="0"
                           data-val-range-max="@punteoMaximo" />

                    <span asp-validation-for="Calificacion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Retroalimentacion" class="form-label">
                        Retroalimentación
                    </label>

                    <textarea asp-for="Retroalimentacion" class="form-control" rows="5">
                    </textarea>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="Devolver" class="form-check-input" />

                    <label asp-for="Devolver" class="form-check-label">
                        Devolver al alumno para corrección
                    </label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="app-btn app-btn-secondary">
                        Cancelar
                    </a>

                    <button class="app-btn app-btn-soft-primary">
                        Guardar revisión
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById('selector-intento-calificar')?.addEventListener('change', function () {
            if (this.value) {
                window.location.assign(this.value);
            }
        });
    </script>
}
