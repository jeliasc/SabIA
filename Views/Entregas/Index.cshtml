@model IEnumerable<Proyecto_Final.ViewModels.Entregas.EntregaLista>

@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad

@inject IAuthorizationService A

@{
    ViewData["Title"] = "Entregas";

    var puedeVer = (await A.AuthorizeAsync(
        User,
        Permisos.Entregas.Ver
    )).Succeeded;

    var calificar = (await A.AuthorizeAsync(
        User,
        Permisos.Entregas.Calificar
    )).Succeeded;

    var soloLectura = ViewData["SoloLectura"] as bool? ?? false;

    // El listado sólo navega; las acciones se validan y se muestran dentro
    // del historial del contexto académico seleccionado.
    var hayAcciones = Model.Any(x =>
        puedeVer ||
        (calificar && x.PuedeCalificarse && x.EntregaCalificableId.HasValue));
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                @(soloLectura ? "Historial de entregas" : "Entregas")
            </h2>

            <p class="text-muted mb-0">
                Actividades pendientes, enviadas y calificadas.
            </p>
        </div>

        <a asp-action="@(soloLectura ? "Index" : "Historial")" class="app-btn app-btn-soft-primary">
            @(soloLectura ? "Ver vigentes" : "Ver historial")
        </a>
    </div>

    <!-- Vista de escritorio -->
    <div class="card shadow-sm border border-secondary d-none d-md-block">
        <div class="card-body">
            <table class="table app-table w-100" data-tabla-index
                   data-actions-column="@(hayAcciones ? "true" : "false")">
                <thead>
                    <tr>
                        <th>Alumno</th>
                        <th>Tarea</th>
                        <th>Curso</th>
                        <th>Última entrega</th>
                        <th>Intentos</th>
                        <th>Estado de la actividad</th>
                        <th>Calificación</th>

                        @if (hayAcciones)
                        {
                            <th>Acciones</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td>@x.Alumno</td>

                            <td class="fw-semibold">
                                @x.Tarea
                            </td>

                            <td>@x.Curso</td>

                            <td>
                                @(x.FechaEntrega?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Pendiente")
                            </td>

                            <td>
                                @x.CantidadIntentos ordinarios
                                @((x.IntentosPermitidos ?? 0) == 0
                                    ? "(ilimitados)"
                                    : $"de {x.IntentosPermitidos}")

                                @if (x.OportunidadesAdicionales > 0)
                                {
                                    <span class="small text-muted">
                                        &middot; @x.OportunidadesAdicionales autorizada(s),
                                        @x.OportunidadesAdicionalesConsumidas consumida(s)

                                        @if (x.OportunidadesAdicionalesVigentes > 0)
                                        {
                                            <text>, @x.OportunidadesAdicionalesVigentes vigente(s)</text>
                                        }

                                        @if (x.OportunidadesAdicionalesVencidas > 0)
                                        {
                                            <text>, @x.OportunidadesAdicionalesVencidas vencida(s)</text>
                                        }
                                    </span>
                                }
                            </td>

                            <td>
                                <span class="app-badge @x.ClaseEstadoActividad">
                                    @x.EstadoActividad
                                </span>

                                @if (!string.IsNullOrWhiteSpace(x.ObservacionEstadoActividad))
                                {
                                    <div class="small text-muted mt-1">
                                        @x.ObservacionEstadoActividad
                                    </div>
                                }
                            </td>

                            <td>
                                @(x.Calificacion.HasValue
                                    ? $"{x.Calificacion}/{x.PunteoMaximo}"
                                    : "-")
                            </td>

                            @if (hayAcciones)
                            {
                                <td>
                                    <div class="app-actions app-actions-table">
                                        @if (calificar &&
                                             x.PuedeCalificarse &&
                                             x.EntregaCalificableId.HasValue)
                                        {
                                            <a asp-action="Calificar" asp-route-id="@x.EntregaCalificableId"
                                               class="app-btn app-btn-soft-primary app-btn-sm">
                                                Calificar
                                            </a>
                                        }

                                        @if (puedeVer)
                                        {
                                            <a asp-action="Detalle" asp-route-id="@x.Id"
                                               class="app-btn app-btn-soft-secondary app-btn-sm">
                                                Ver actividad
                                            </a>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Vista móvil -->
    <div class="d-md-none" id="entregasMovil">
        <div class="mb-3">
            <div class="d-grid">
                <button type="button" class="app-btn app-btn-secondary" aria-expanded="false"
                        aria-controls="busqueda-entregas-movil" data-mostrar-busqueda-entregas>
                    <i class="bi bi-search" aria-hidden="true"></i>
                    Buscar entrega
                </button>
            </div>

            <div id="busqueda-entregas-movil" class="mt-2 d-none" data-contenedor-busqueda-entregas>
                <input type="search" id="buscarEntregaMovil" class="form-control"
                       placeholder="Alumno, tarea, curso, estado o calificación..." aria-label="Buscar entregas"
                       autocomplete="off" />
            </div>
        </div>

        <div data-lista-entregas-movil>
            @foreach (var x in Model)
            {
                <div class="card border-0 shadow-sm mb-3 entrega-movil-item"
                     data-busqueda="@($"{x.Alumno} {x.Tarea} {x.Curso} {x.FechaEntrega?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")} {x.EstadoActividad} {x.Calificacion} {x.PunteoMaximo}")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2">
                            <div class="fw-bold">
                                @x.Tarea
                            </div>

                            <span class="app-badge @x.ClaseEstadoActividad">
                                @x.EstadoActividad
                            </span>
                        </div>

                        <div class="text-muted">
                            @x.Curso
                        </div>

                        <div class="small mb-3">
                            @x.Alumno
                        </div>
                        @if (!string.IsNullOrWhiteSpace(x.ObservacionEstadoActividad))
                        {
                            <div class="small text-muted mb-2">
                                @x.ObservacionEstadoActividad
                            </div>
                        }

                        @if (x.FechaLimiteIndividual.HasValue)
                        {
                            <div class="small text-danger mb-3">
                                Plazo individual:
                                @x.FechaLimiteIndividual.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </div>
                        }

                        <div class="small text-muted mb-3">
                            @x.CantidadIntentos ordinarios
                            @((x.IntentosPermitidos ?? 0) == 0
                                ? "(ilimitados)"
                                : $"de {x.IntentosPermitidos}")

                            @if (x.OportunidadesAdicionales > 0)
                            {
                                <span>
                                    &middot; @x.OportunidadesAdicionales autorizada(s),
                                    @x.OportunidadesAdicionalesConsumidas consumida(s)
                                </span>

                                @if (x.OportunidadesAdicionalesVigentes > 0)
                                {
                                    <span>
                                        , @x.OportunidadesAdicionalesVigentes vigente(s)
                                    </span>
                                }

                                @if (x.OportunidadesAdicionalesVencidas > 0)
                                {
                                    <span>
                                        , @x.OportunidadesAdicionalesVencidas vencida(s)
                                    </span>
                                }
                            }
                        </div>

                        @if (x.Calificacion.HasValue)
                        {
                            <div class="small mb-3">
                                Calificación vigente:
                                @x.Calificacion / @x.PunteoMaximo
                            </div>
                        }

                        @if (puedeVer)
                        {
                            <a asp-action="Detalle" asp-route-id="@x.Id" class="app-btn app-btn-soft-secondary w-100 mt-2">
                                Ver actividad e historial
                            </a>
                        }

                        @if (calificar &&
                             x.PuedeCalificarse &&
                             x.EntregaCalificableId.HasValue)
                        {
                            <a asp-action="Calificar" asp-route-id="@x.EntregaCalificableId"
                               class="app-btn app-btn-soft-primary w-100 mt-2">
                                Calificar
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <p class="text-muted text-center py-3 d-none" data-sin-entregas-movil>
            No se encontraron entregas.
        </p>

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
            <span class="small text-muted" data-contador-entregas-movil></span>

            <div class="d-flex gap-2">
                <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm" data-anterior-entregas-movil>
                    Anterior
                </button>

                <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm" data-siguiente-entregas-movil>
                    Siguiente
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/entregas.js" asp-append-version="true"></script>
    <script src="~/js/entregas-index.js" asp-append-version="true"></script>
}
