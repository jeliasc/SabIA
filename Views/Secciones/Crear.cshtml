@model Proyecto_Final.ViewModels.Secciones.CrearSeccion
@{
    ViewData["Title"] = "Nueva sección";
}
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <div class="mb-4">
                <h2 class="fw-bold mb-1">Nueva sección</h2>
            </div>
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form method="post">@Html.AntiForgeryToken()
                        <partial name="Formulario" model="Model" />
                        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="app-btn app-btn-soft-secondary">Cancelar</a>
                            <button type="submit" class="app-btn app-btn-soft-primary">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}