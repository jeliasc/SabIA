@model Proyecto_Final.ViewModels.PermisosSistema.CrearPermiso

@{
    ViewData["Title"] = "Nuevo permiso";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-lg-10 col-xl-9">
    
            <!-- ENCABEZADO -->
            <div class="d-flex justify-content-between align-items-center gap-3 mb-4">

                <div>
                    <h2 class="mb-0 fw-semibold">
                        Nuevo permiso
                    </h2>

                    <p class="text-body-secondary mb-0">
                        Registre un nuevo permiso para el sistema.
                    </p>
                </div>

                <a asp-action="Index" class="app-btn app-btn-soft-secondary">

                    <i class="bi bi-arrow-left me-1"></i>
                    Regresar

                </a>

            </div>

            <div class="card card-outline card-primary shadow-sm">

                <div class="card-header">

                    <h3 class="card-title mb-0">
                        Información del permiso
                    </h3>

                </div>

                <div class="card-body">

                    <form asp-action="Crear" method="post" data-modo="crear">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <partial name="Formulario" model="Model" />

                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index" class="app-btn app-btn-soft-secondary">
                                Cancelar
                            </a>

                            <button type="submit" class="app-btn app-btn-soft-primary">

                                <i class="bi bi-floppy me-1"></i>
                                Guardar permiso

                            </button>

                        </div>

                    </form>

                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/permisos-sistema.js" asp-append-version="true"></script>
}