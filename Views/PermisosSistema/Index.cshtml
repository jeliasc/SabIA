@model Proyecto_Final.ViewModels.PermisosSistema.PermisosSistemaIndex

@{
    ViewData["Title"] = "Permisos";
}

<div class="container-fluid">

    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">

                <i class="bi bi-key fs-4 text-primary"></i>

                <h2 class="mb-0 fw-semibold">
                    Permisos
                </h2>

            </div>

            <p class="text-body-secondary mb-0">
                Administración de permisos del sistema.
            </p>
        </div>

        @if (User.HasClaim(
            TiposClaims.Permiso,
            "Permisos.Crear"))
        {
            <a asp-action="Crear" class="app-btn app-btn-soft-primary">

                <i class="bi bi-plus-lg me-1"></i>
                Nuevo permiso

            </a>
        }

    </div>

    <div class="card card-outline card-primary shadow-sm">

        <div class="card-header d-flex align-items-center justify-content-between">

            <h3 class="card-title mb-0">
                Permisos registrados
            </h3>

            <span class="text-body-secondary small">
                @Model.Permisos.Count registros
            </span>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table id="tablaPermisos" class="table app-table" data-tabla-index
                       data-search-placeholder="Código, módulo o descripción..."
                       data-empty-message="No existen permisos registrados" data-zero-message="No se encontraron permisos">

                    <thead>
                        <tr>

                            <th>
                                Permiso
                            </th>

                            <th class="d-none d-lg-table-cell">
                                Módulo
                            </th>

                            <th class="d-none d-lg-table-cell">
                                Descripción
                            </th>

                            <th>
                                Estado
                            </th>

                            <th class="text-end text-nowrap">
                                Acciones
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var permiso in Model.Permisos)
                        {
                            <tr>

                                <td>

                                    <div class="fw-semibold text-break">
                                        @permiso.Codigo
                                    </div>

                                    <div class="d-lg-none small text-body-secondary mt-1">
                                        @permiso.Modulo
                                    </div>

                                    <div class="d-lg-none small text-body-secondary">
                                        @permiso.Descripcion
                                    </div>

                                </td>

                                <td class="d-none d-lg-table-cell">
                                    @permiso.Modulo
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    @permiso.Descripcion
                                </td>

                                <td>

                                    @if (permiso.Activo)
                                    {
                                        <span class="app-badge app-badge-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="app-badge app-badge-danger">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td class="text-end text-nowrap">

                                    @if (User.HasClaim(
                                        TiposClaims.Permiso,
                                        "Permisos.Editar"))
                                    {
                                        <a asp-action="Editar" asp-route-id="@permiso.Id"
                                           class="app-btn app-btn-soft-secondary">

                                            <i class="bi bi-pencil"></i>

                                            <span class="d-none d-xl-inline">
                                                Editar
                                            </span>

                                        </a>
                                    }

                                    @if (permiso.Activo)
                                    {
                                        @if (User.HasClaim(
                                            TiposClaims.Permiso,
                                            "Permisos.CambiarEstado"))
                                        {
                                            <form asp-action="Desactivar" method="post" class="d-inline formulario-cambiar-estado"
                                                  data-accion="desactivar" data-nombre="@permiso.Codigo">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="id" value="@permiso.Id" />

                                                <button type="submit" class="app-btn app-btn-soft-danger btn-sm">

                                                    <i class="bi bi-shield-x"></i>

                                                    <span class="d-none d-xl-inline">
                                                        Desactivar
                                                    </span>

                                                </button>

                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        @if (User.HasClaim(
                                            TiposClaims.Permiso,
                                            "Permisos.CambiarEstado"))
                                        {
                                            <form asp-action="Activar" method="post" class="d-inline formulario-cambiar-estado"
                                                  data-accion="activar" data-nombre="@permiso.Codigo">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="id" value="@permiso.Id" />

                                                <button type="submit" class="app-btn app-btn-soft-success btn-sm">

                                                    <i class="bi bi-shield-check"></i>

                                                    <span class="d-none d-xl-inline">
                                                        Activar
                                                    </span>

                                                </button>

                                            </form>
                                        }
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/js/permisos-sistema.js" asp-append-version="true"></script>
}