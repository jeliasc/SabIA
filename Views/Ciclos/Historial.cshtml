@model IReadOnlyList<Proyecto_Final.ViewModels.Ciclos.MovimientoCicloLista>
@{
    ViewData["Title"] = "Historial del ciclo";
    var anio = ViewData["Anio"];
}

<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Historial del ciclo @anio</h2>
            <p class="text-muted mb-0">Transiciones institucionales conservadas de forma permanente.</p>
        </div>
        <a asp-action="Index" class="app-btn app-btn-soft-secondary">Volver</a>
    </div>
    <div class="card shadow-sm border border-secondary d-none d-md-block">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table app-table align-middle">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Movimiento</th>
                            <th>Transición</th>
                            <th>Responsable</th>
                            <th>Justificación</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">El ciclo todavía no tiene movimientos
                                    registrados.</td>
                                </tr>
                            }
                                        else
                            {
                                @foreach (var movimiento in Model)
                                {
                                    <tr>
                                        <td class="text-nowrap">@movimiento.FechaUtc.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td>@movimiento.Tipo.GetDisplayName()</td>
                                        <td>@movimiento.EstadoAnterior.GetDisplayName() → @movimiento.EstadoNuevo.GetDisplayName()
                                        </td>
                                        <td>@movimiento.Responsable</td>
                                        <td class="text-break">@(movimiento.Justificacion ?? "—")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="d-md-none" id="historialCiclosMovil">
    <div class="mb-3">
        <div class="d-grid">
            <button type="button" class="app-btn app-btn-secondary" aria-expanded="false"
                    aria-controls="busqueda-historial-ciclos-movil" data-mostrar-busqueda-historial-ciclos>
                <i class="bi bi-search" aria-hidden="true"></i>
                Buscar movimiento
            </button>
        </div>
        <div id="busqueda-historial-ciclos-movil" class="mt-2 d-none" data-contenedor-busqueda-historial-ciclos>
            <input type="search" id="buscarHistorialCicloMovil" class="form-control"
                   placeholder="Fecha, movimiento, estado o responsable..." aria-label="Buscar movimientos del ciclo"
                   autocomplete="off" />
        </div>
    </div>
    <div data-lista-historial-ciclos-movil>
        @foreach (var movimiento in Model)
        {
            var transicion = $"{movimiento.EstadoAnterior.GetDisplayName()} → {movimiento.EstadoNuevo.GetDisplayName()}";
            <article class="card shadow-sm border-0 mb-3 historial-ciclo-movil-item"
                     data-busqueda="@($"{movimiento.FechaUtc:dd/MM/yyyy HH:mm:ss} {movimiento.Tipo.GetDisplayName()} {transicion} {movimiento.Responsable} {movimiento.Justificacion}")">
                <div class="card-body">
                    <div class="fw-bold">@movimiento.Tipo.GetDisplayName()</div>
                    <div class="text-muted mb-3">@movimiento.FechaUtc.ToString("dd/MM/yyyy HH:mm:ss")</div>
                    <div class="mb-2"><span class="small text-muted d-block">Transición</span>@transicion</div>
                    <div class="mb-2"><span class="small text-muted d-block">Responsable</span>@movimiento.Responsable</div>
                    <div><span class="small text-muted d-block">Justificación</span>@(movimiento.Justificacion ?? "—")</div>
                </div>
            </article>
        }
    </div>
    <p class="text-muted text-center py-3 d-none" data-sin-historial-ciclos-movil>No se encontraron movimientos.</p>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span class="small text-muted" data-contador-historial-ciclos-movil></span>
        <div class="d-flex gap-2">
            <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm"
                    data-anterior-historial-ciclos-movil>
                Anterior
            </button>
            <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm"
                    data-siguiente-historial-ciclos-movil>
                Siguiente
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ciclos-historial.js" asp-append-version="true"></script>
}