@model IReadOnlyList<Proyecto_Final.ViewModels.Ciclos.MovimientoCicloLista>
@{
    ViewData["Title"] = "Historial del ciclo";
    var anio = ViewData["Anio"];
}

<div class="container-fluid">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div><h2 class="fw-bold mb-1">Historial del ciclo @anio</h2><p class="text-muted mb-0">Transiciones institucionales conservadas de forma permanente.</p></div>
        <a asp-action="Index" class="app-btn app-btn-soft-secondary">Volver</a>
    </div>
    <div class="card shadow-sm border border-secondary"><div class="card-body"><div class="table-responsive">
        <table class="table app-table align-middle">
            <thead><tr><th>Fecha (UTC)</th><th>Movimiento</th><th>Transición</th><th>Responsable</th><th>Justificación</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted py-4">El ciclo todavía no tiene movimientos registrados.</td></tr>
            }
            else
            {
                @foreach (var movimiento in Model)
                {
                    <tr>
                        <td class="text-nowrap">@movimiento.FechaUtc.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td>@movimiento.Tipo</td><td>@movimiento.EstadoAnterior → @movimiento.EstadoNuevo</td>
                        <td>@movimiento.Responsable</td><td class="text-break">@(movimiento.Justificacion ?? "—")</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div></div></div>
</div>
