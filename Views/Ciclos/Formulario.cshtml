@model Proyecto_Final.ViewModels.Ciclos.FormularioCiclo
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-4"><label asp-for="Anio" class="form-label"></label><input asp-for="Anio" class="form-control" /><span asp-validation-for="Anio" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="FechaInicio" class="form-label"></label><input asp-for="FechaInicio" type="date" class="form-control" /><span asp-validation-for="FechaInicio" class="text-danger small"></span></div>
    <div class="col-md-4"><label asp-for="FechaFin" class="form-label"></label><input asp-for="FechaFin" type="date" class="form-control" /><span asp-validation-for="FechaFin" class="text-danger small"></span></div>
</div>