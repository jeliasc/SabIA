@model IEnumerable<Proyecto_Final.ViewModels.Ciclos.CicloLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService Autorizacion
@{
    ViewData["Title"] = "Ciclos escolares";
    var puedeCrear = (await Autorizacion.AuthorizeAsync(User, Permisos.Ciclos.Crear)).Succeeded;
    var puedeEditar = (await Autorizacion.AuthorizeAsync(User, Permisos.Ciclos.Editar)).Succeeded;
    var puedeActivar = (await Autorizacion.AuthorizeAsync(User, Permisos.Ciclos.Activar)).Succeeded;
}
<div class="container-fluid">
    <partial name="_AlertasResultado" />
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div><h2 class="fw-bold mb-1">Ciclos escolares</h2><p class="text-muted mb-0">Administración de períodos lectivos.</p></div>
        @if (puedeCrear) { <a asp-action="Crear" class="app-btn app-btn-soft-primary">Nuevo ciclo</a> }
    </div>
    <div class="card shadow-sm border border-secondary"><div class="card-body"><div class="table-responsive">
        <table class="table app-table w-100" data-tabla-index data-actions-column="true" data-search-placeholder="Año..." data-empty-message="No existen ciclos escolares">
            <thead><tr><th>Año</th><th>Inicio</th><th>Fin</th><th>Períodos</th><th>Secciones</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>@foreach (var x in Model) { <tr>
                <td class="fw-semibold">@x.Anio</td><td>@x.Inicio.ToString("dd/MM/yyyy")</td><td>@x.Fin.ToString("dd/MM/yyyy")</td><td>@x.Periodos</td><td>@x.Secciones</td>
                <td><span class="app-badge @(x.Activo ? "app-badge-success" : "app-badge-secondary")">@(x.Activo ? "Activo" : "Inactivo")</span></td>
                <td class="app-actions-cell"><div class="app-actions app-actions-table">
                    @if (puedeEditar) { <a asp-action="Editar" asp-route-id="@x.Id" class="app-btn app-btn-soft-secondary app-btn-sm">Editar</a> }
                    @if (puedeActivar && !x.Activo) { <form asp-action="Activar" asp-route-id="@x.Id" method="post" class="m-0">@Html.AntiForgeryToken()<button class="app-btn app-btn-soft-success app-btn-sm" type="submit">Activar</button></form> }
                </div></td>
            </tr> }</tbody>
        </table>
    </div></div></div>
</div>
