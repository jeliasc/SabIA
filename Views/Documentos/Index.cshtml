@model IEnumerable<Proyecto_Final.ViewModels.Documentos.DocumentoLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService A

@{
    ViewData["Title"] = "Documentos";

    var c = (await A.AuthorizeAsync(
        User,
        Permisos.Documentos.Crear
    )).Succeeded;

    var d = (await A.AuthorizeAsync(
        User,
        Permisos.Documentos.Descargar
    )).Succeeded;
    var hayAcciones = Model.Any() && d;
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Documentos internos
            </h2>

            <p class="text-muted mb-0">
                Espacio restringido para Coordinación y docentes. No es visible para alumnos.
            </p>
        </div>

        @if (c)
        {
            <a asp-action="Crear" class="app-btn app-btn-soft-primary">
                Cargar documento
            </a>
        }
    </div>

    <div class="card shadow-sm border border-secondary d-none d-lg-block">
        <div class="card-body">
            <table class="table app-table w-100" data-tabla-index
                   data-actions-column="@(hayAcciones ? "true" : "false")">
                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>Subido por</th>
                        <th>Fecha</th>
                        <th>Tamaño</th>
                        @if (hayAcciones)
                        {
                            <th>Acción</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @foreach (var x in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @x.Nombre
                            </td>

                            <td>
                                @x.SubidoPor
                            </td>

                            <td>
                                @x.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @Math.Round(x.Tamano / 1024d, 1) KB
                            </td>

                            @if (hayAcciones)
                            {
                                <td>
                                    @if (d)
                                    {
                                        <a asp-action="Descargar" asp-route-id="@x.Id"
                                           class="app-btn app-btn-soft-secondary app-btn-sm">
                                            Descargar
                                        </a>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Vista móvil de documentos -->
<div class="d-lg-none" id="documentosMovil">

    <div class="mb-3">
        <div class="d-grid">
            <button type="button" class="app-btn app-btn-secondary" aria-expanded="false"
                    aria-controls="busqueda-documentos-movil" data-mostrar-busqueda-documentos>
                <i class="bi bi-search" aria-hidden="true"></i>
                Buscar documento
            </button>
        </div>

        <div id="busqueda-documentos-movil" class="mt-2 d-none" data-contenedor-busqueda-documentos>
            <input type="search" id="buscarDocumentoMovil" class="form-control"
                   placeholder="Documento, usuario o fecha..." aria-label="Buscar documentos" autocomplete="off" />
        </div>
    </div>

    <div id="listaDocumentosMovil">
        @foreach (var x in Model)
        {
            <div class="card border-0 shadow-sm mb-3 documento-movil-item"
                 data-busqueda="@($"{x.Nombre} {x.SubidoPor} {x.Fecha.ToLocalTime():dd/MM/yyyy HH:mm} {Math.Round(x.Tamano / 1024d, 1)}".ToLowerInvariant())">

                <div class="card-body">
                    <div class="fw-semibold mb-3">
                        @x.Nombre
                    </div>

                    <div class="mb-2">
                        <span class="text-muted">Subido por:</span>
                        <span class="fw-medium">@x.SubidoPor</span>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted">Fecha:</span>
                        <span>@x.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted">Tamaño:</span>
                        <span>@Math.Round(x.Tamano / 1024d, 1) KB</span>
                    </div>

                    @if (d)
                    {
                        <div class="d-grid">
                            <a asp-action="Descargar" asp-route-id="@x.Id" class="app-btn app-btn-soft-secondary app-btn-sm">
                                Descargar
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <p id="sinDocumentosMovil" class="text-muted text-center py-3 d-none">
        No se encontraron documentos.
    </p>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span id="contadorDocumentosMovil" class="small text-muted"></span>

        <div class="d-flex gap-2">
            <button type="button" id="anteriorDocumentosMovil" class="app-btn app-btn-soft-secondary app-btn-sm">
                Anterior
            </button>

            <button type="button" id="siguienteDocumentosMovil" class="app-btn app-btn-soft-secondary app-btn-sm">
                Siguiente
            </button>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/documentos-index.js" asp-append-version="true"></script>
}
