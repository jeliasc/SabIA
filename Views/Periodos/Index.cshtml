@model IEnumerable<Proyecto_Final.ViewModels.Periodos.PeriodoLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService Autorizacion

@{
    ViewData["Title"] = "Períodos";

    var crear = (await Autorizacion.AuthorizeAsync(
        User,
        Permisos.Periodos.Crear
    )).Succeeded;

    var editar = (await Autorizacion.AuthorizeAsync(
        User,
        Permisos.Periodos.Editar
    )).Succeeded;
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Períodos
            </h2>

            <p class="text-muted mb-0">
                Períodos académicos definidos por ciclo escolar.
            </p>
        </div>

        @if (crear)
        {
            <a asp-action="Crear" class="app-btn app-btn-soft-primary">
                Nuevo período
            </a>
        }
    </div>

    <div class="card shadow-sm border border-secondary">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table app-table w-100" data-tabla-index data-actions-column="true"
                       data-search-placeholder="Ciclo o período...">
                    <thead>
                        <tr>
                            <th class="text-start">Ciclo</th>
                            <th class="text-start">No.</th>
                            <th>Nombre</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td class="text-start">@x.Ciclo</td>

                                <td class="text-start">@x.Numero</td>

                                <td class="fw-semibold">
                                    @x.Nombre
                                </td>

                                <td>
                                    @x.Inicio.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @x.Fin.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end">
                                    @if (editar)
                                    {
                                        <a asp-action="Editar" asp-route-id="@x.Id"
                                           class="app-btn app-btn-soft-secondary app-btn-sm">
                                            Editar
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
