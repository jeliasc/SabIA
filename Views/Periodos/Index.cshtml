@model IEnumerable<Proyecto_Final.ViewModels.Periodos.PeriodoLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService Autorizacion

@{
    ViewData["Title"] = "Períodos";

    var crear = (await Autorizacion.AuthorizeAsync(
        User,
        Permisos.Periodos.Crear
    )).Succeeded;

    var editar = (await Autorizacion.AuthorizeAsync(
        User,
        Permisos.Periodos.Editar
    )).Succeeded;
    var hayAcciones = Model.Any() && editar;
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Períodos
            </h2>

            <p class="text-muted mb-0">
                Períodos académicos definidos por ciclo escolar.
            </p>
        </div>

        @if (crear)
        {
            <a asp-action="Crear" class="app-btn app-btn-soft-primary">
                Nuevo período
            </a>
        }
    </div>

    <div class="card shadow-sm border border-secondary d-none d-md-block">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table app-table w-100" data-tabla-index
                       data-actions-column="@(hayAcciones ? "true" : "false")"
                       data-search-placeholder="Ciclo o período...">
                    <thead>
                        <tr>
                            <th class="text-start">Ciclo</th>
                            <th class="text-start">No.</th>
                            <th>Nombre</th>
                            <th>Inicio</th>
                            <th>Fin</th>
                            @if (hayAcciones)
                            {
                                <th class="text-end">Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td class="text-start">@x.Ciclo</td>

                                <td class="text-start">@x.Numero</td>

                                <td class="fw-semibold">
                                    @x.Nombre
                                </td>

                                <td>
                                    @x.Inicio.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @x.Fin.ToString("dd/MM/yyyy")
                                </td>

                                @if (hayAcciones)
                                {
                                    <td class="text-end">
                                        @if (editar)
                                        {
                                            <a asp-action="Editar" asp-route-id="@x.Id"
                                               class="app-btn app-btn-soft-secondary app-btn-sm">
                                                Editar
                                            </a>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="d-md-none" id="periodosMovil">
    <div class="mb-3">
        <div class="d-grid">
            <button type="button" class="app-btn app-btn-secondary" aria-expanded="false"
                    aria-controls="busqueda-periodos-movil" data-mostrar-busqueda-periodos>
                <i class="bi bi-search" aria-hidden="true"> </i>
                Buscar período
            </button>
        </div>
        <div id="busqueda-periodos-movil" class="mt-2 d-none" data-contenedor-busqueda-periodos>
            <input type="search" id="buscarPeriodoMovil" class="form-control"
                   placeholder="Ciclo, período, nombre o fecha..." aria-label="Buscar períodos" autocomplete="off" />
        </div>
    </div>
    <div data-lista-periodos-movil>
        @foreach (var x in Model)
        {
            <article class="card shadow-sm border-0 mb-3 periodo-movil-item"
                     data-busqueda="@($"{x.Ciclo} {x.Numero} {x.Nombre} {x.Inicio:dd/MM/yyyy} {x.Fin:dd/MM/yyyy}")">
                <div class="card-body">
                    <div class="fw-bold">@x.Nombre</div>
                    <div class="text-muted mb-3">Ciclo @x.Ciclo · Período @x.Numero</div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <span class="small text-muted d-block">Inicio</span>@x.Inicio.ToString("dd/MM/yyyy")
                        </div>
                        <div class="col-6">
                            <span class="small text-muted d-block">Fin</span>@x.Fin.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                    @if (editar)
                    {
                        <a asp-action="Editar" asp-route-id="@x.Id" class="app-btn app-btn-soft-secondary w-100">Editar</a>
                    }
                </div>
            </article>
        }
    </div>
    <p class="text-muted text-center py-3 d-none" data-sin-periodos-movil>No se encontraron períodos.</p>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span class="small text-muted" data-contador-periodos-movil> </span>
        <div class="d-flex gap-2">
            <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm"
                    data-anterior-periodos-movil>Anterior
            </button>
            <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm" data-siguiente-periodos-movil>
                Siguiente
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/periodos-index.js" asp-append-version="true"></script>
}
