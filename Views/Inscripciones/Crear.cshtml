@model Proyecto_Final.ViewModels.Inscripciones.CrearInscripcion

@{
    ViewData["Title"] = "Nueva inscripción";
}

<div class="container-fluid">
    <h2 class="fw-bold mb-4">
        Nueva inscripción
    </h2>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3">
                </div>

                <div class="row g-3">
                    <div class="col-md-5" data-alumnos-inscripcion>
                        <label asp-for="AlumnoId" class="form-label">
                            Alumno
                        </label>

                        <select asp-for="AlumnoId" class="form-select" data-select-busqueda
                                data-search-placeholder="Buscar por nombre o Código Personal MINEDUC...">
                            <option value="">Seleccione...</option>

                            @foreach (var x in Model.Alumnos)
                            {
                                <option value="@x.Id" data-ciclos-no-disponibles="@string.Join(",", x.CiclosConInscripcionActiva)">
                                    @x.Texto
                                </option>
                            }
                        </select>

                        <span asp-validation-for="AlumnoId" class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="Fecha" class="form-label">
                            Fecha
                        </label>

                        <input asp-for="Fecha" type="date" class="form-control" />
                    </div>
                </div>

                <div class="alert alert-info mt-3 d-none" role="status" data-no-alumnos-inscripcion>
                    No hay alumnos disponibles para inscripción en el ciclo seleccionado.
                </div>

                <div class="mt-3">
                    <partial name="_SeleccionAcademica" model="Model" />
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="app-btn app-btn-secondary">
                        Cancelar
                    </a>

                    <button class="app-btn app-btn-soft-primary">
                        Inscribir
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/seleccion-academica.js" asp-append-version="true"></script>
    <script src="~/js/alumnos-inscripcion.js" asp-append-version="true"></script>
}
