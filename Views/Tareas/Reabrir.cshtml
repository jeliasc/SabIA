@model Proyecto_Final.ViewModels.Tareas.ReabrirTarea
@using Proyecto_Final.Models
@{
    ViewData["Title"] = "Reabrir actividad";
}
<div class="container-fluid">
    <partial name="_AlertasResultado" />
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Reabrir para todos</h2>
        <p class="text-muted mb-0">@Model.Titulo · @Model.Curso</p>
    </div>
    <div class="app-card">
        <div class="app-card-body">
            <form asp-action="Reabrir" method="post" data-confirmar-accion-academica
                  data-confirmar-titulo="Reabrir actividad"
                  data-confirmar-mensaje="Se registrará una autorización por alumno beneficiado."
                  data-confirmar-texto="Reabrir">
                <input asp-for="Id" type="hidden" />
                <input asp-for="TokenSolicitud" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="FechaLimite" class="form-label">Nueva fecha límite</label>
                        <input asp-for="FechaLimite" type="datetime-local" class="form-control" />
                        <span asp-validation-for="FechaLimite" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Alcance" class="form-label">Alcance</label>
                        <select asp-for="Alcance" class="form-select">
                            <option value="@AlcanceReaperturaTarea.SoloPendientes">Solo alumnos pendientes</option>
                            <option value="@AlcanceReaperturaTarea.Todos">Todos los alumnos (autoriza nueva oportunidad)
                            </option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Motivo" class="form-label">Motivo</label>
                        <textarea asp-for="Motivo" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Motivo" class="text-danger"></span>
                    </div>
                </div>
                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="app-btn app-btn-soft-secondary">Cancelar</a>
                    <button type="submit" class="app-btn app-btn-warning">Confirmar reapertura</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/acciones-academicas.js" asp-append-version="true"></script>
}
