@model IEnumerable<Proyecto_Final.ViewModels.Tareas.TareaLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService A

@{
    ViewData["Title"] = "Tareas";

    var c = (await A.AuthorizeAsync(
        User,
        Permisos.Tareas.Crear
    )).Succeeded;

    var e = (await A.AuthorizeAsync(
        User,
        Permisos.Tareas.Editar
    )).Succeeded;

    var p = (await A.AuthorizeAsync(
        User,
        Permisos.Tareas.Publicar
    )).Succeeded;

    var cerrar = (await A.AuthorizeAsync(
        User,
        Permisos.Tareas.Cerrar
    )).Succeeded;

    var reabrir = (await A.AuthorizeAsync(
        User,
        Permisos.Entregas.Reabrir
    )).Succeeded;

    var cuest = (await A.AuthorizeAsync(
        User,
        Permisos.Cuestionarios.Crear
    )).Succeeded;

    var soloLectura = ViewData["SoloLectura"] as bool? ?? false;
    var hayAcciones = Model.Any(x => soloLectura
        ? x.Estado == Proyecto_Final.Models.EstadoTarea.Cerrada &&
          x.PuedeReabrirse && reabrir
        : (x.Estado == Proyecto_Final.Models.EstadoTarea.Borrador && (e || p)) ||
          (x.Estado == Proyecto_Final.Models.EstadoTarea.Publicada && e) ||
          (x.Tipo == Proyecto_Final.Models.TipoTarea.Cuestionario &&
           x.Estado == Proyecto_Final.Models.EstadoTarea.Borrador && cuest) ||
          (x.Estado == Proyecto_Final.Models.EstadoTarea.Publicada && cerrar) ||
          (x.PuedeReabrirse && reabrir));
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Tareas
            </h2>

            <p class="text-muted mb-0">
                Actividades por curso, publicación y seguimiento de entregas.
            </p>
        </div>

        <div class="d-grid d-md-flex align-items-center gap-2">

            @if (!soloLectura && c)
            {
                <a asp-action="Crear" class="app-btn app-btn-soft-primary">
                    Nueva tarea
                </a>
            }

            @if (soloLectura)
            {
                <a asp-action="Index" class="app-btn app-btn-soft-secondary">
                    Ver vigentes
                </a>
            }
            else
            {
                <a asp-action="Historial" class="app-btn app-btn-soft-secondary">
                    Ver historial
                </a>
            }

        </div>
    </div>

    <div class="card shadow-sm border border-secondary d-none d-md-block">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table app-table w-100" data-tabla-index
                       data-actions-column="@(hayAcciones ? "true" : "false")">
                    <thead>
                        <tr>
                            <th>Tarea</th>
                            <th>Curso</th>
                            <th>Sección</th>
                            <th>Tipo</th>
                            <th>Límite</th>
                            <th>Seguimiento</th>
                            <th>Estado administrativo</th>
                            <th>Disponibilidad</th>
                            @if (hayAcciones)
                            {
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @x.Titulo
                                </td>

                                <td>@x.Curso</td>

                                <td>@x.Seccion</td>

                                <td>@x.Tipo.GetDisplayName()</td>

                                <td>
                                    @(x.Limite?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Sin límite")
                                </td>

                                <td>
                                    @x.Entregadas entregadas / @x.Pendientes pendientes
                                </td>

                                <td>
                                    <span class="app-badge @(x.Estado == Proyecto_Final.Models.EstadoTarea.Publicada
                                          ? "app-badge-success"
                                          : x.Estado == Proyecto_Final.Models.EstadoTarea.Cerrada
                                            ? "app-badge-danger"
                                            : "app-badge-secondary")">
                                        @x.Estado.GetDisplayName()
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(x.IndicadorDisponibilidad))
                                    {
                                        var claseDisponibilidad = x.IndicadorDisponibilidad == "Disponible"
                                            ? "app-badge-success"
                                            : x.IndicadorDisponibilidad == "Reabierta"
                                                ? "app-badge-warning"
                                                : x.IndicadorDisponibilidad == "Plazo vencido" || x.IndicadorDisponibilidad == "Cerrada"
                                                    ? "app-badge-danger"
                                                    : "app-badge-secondary";
                                        <span class="app-badge @claseDisponibilidad">@x.IndicadorDisponibilidad</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Consulta histórica</span>
                                    }
                                </td>
                                @if (hayAcciones)
                                {
                                    <td>
                                        <div class="app-actions d-flex flex-nowrap align-items-center gap-2 text-nowrap">
                                            @if (e &&
                                                (x.Estado == Proyecto_Final.Models.EstadoTarea.Borrador ||
                                                 x.Estado == Proyecto_Final.Models.EstadoTarea.Publicada))
                                            {
                                                <a asp-action="Editar" asp-route-id="@x.Id"
                                                   class="app-btn app-btn-soft-secondary app-btn-sm">
                                                    Editar
                                                </a>
                                            }

                                            @if (cuest &&
                                                x.Tipo == Proyecto_Final.Models.TipoTarea.Cuestionario &&
                                                x.Estado == Proyecto_Final.Models.EstadoTarea.Borrador)
                                            {
                                                <a asp-controller="Cuestionarios" asp-action="Configurar" asp-route-tareaId="@x.Id"
                                                   class="app-btn app-btn-soft-secondary app-btn-sm">
                                                    Continuar configuración
                                                </a>
                                            }

                                            @if (p &&
                                                x.Estado == Proyecto_Final.Models.EstadoTarea.Borrador)
                                            {
                                                <form asp-action="Publicar" asp-route-id="@x.Id" method="post"
                                                      data-confirmar-accion-academica data-confirmar-titulo="Publicar tarea"
                                                      data-confirmar-mensaje="La tarea se habilitará para los alumnos vigentes de la sección."
                                                      data-confirmar-texto="Publicar" data-confirmar-color="#198754">
                                                    @Html.AntiForgeryToken()

                                                    <button class="app-btn app-btn-soft-success app-btn-sm">
                                                        Publicar
                                                    </button>
                                                </form>
                                            }

                                            @if (cerrar &&
                                                x.Estado == Proyecto_Final.Models.EstadoTarea.Publicada)
                                            {
                                                <a asp-action="Cerrar" asp-route-id="@x.Id"
                                                   class="app-btn app-btn-soft-danger app-btn-sm">Cerrar</a>
                                            }

                                            @if (reabrir && x.PuedeReabrirse &&
                                                (!soloLectura || x.Estado == Proyecto_Final.Models.EstadoTarea.Cerrada))
                                            {
                                                <a asp-action="Reabrir" asp-route-id="@x.Id"
                                                   class="app-btn app-btn-soft-warning app-btn-sm">Reabrir para todos</a>
                                            }
                                        </div>
                                    </td>
                                }
                                
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="d-md-none" id="tareasMovil">
    <div class="mb-3">
        <div class="d-grid">
            <button type="button" class="app-btn app-btn-secondary" aria-expanded="false"
                    aria-controls="busqueda-tareas-movil" data-mostrar-busqueda-tareas>
                <i class="bi bi-search" aria-hidden="true"></i>
                Buscar tarea
            </button>
        </div>
        <div id="busqueda-tareas-movil" class="mt-2 d-none" data-contenedor-busqueda-tareas>
            <input type="search" id="buscarTareaMovil" class="form-control"
                   placeholder="Tarea, curso, sección, tipo o estado..." aria-label="Buscar tareas" autocomplete="off" />
        </div>
    </div>

    <div data-lista-tareas-movil>
        @foreach (var x in Model)
        {
            var esBorrador = x.Estado == Proyecto_Final.Models.EstadoTarea.Borrador;
            var esPublicada = x.Estado == Proyecto_Final.Models.EstadoTarea.Publicada;
            var claseEstado = esPublicada
                ? "app-badge-success"
                : x.Estado == Proyecto_Final.Models.EstadoTarea.Cerrada
                    ? "app-badge-danger"
                    : "app-badge-secondary";
            var limite = x.Limite?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Sin límite";
            var disponibilidad = string.IsNullOrWhiteSpace(x.IndicadorDisponibilidad)
                ? "Consulta histórica"
                : x.IndicadorDisponibilidad;

            <article class="card shadow-sm border-0 mb-3 tarea-movil-item"
                     data-busqueda="@($"{x.Titulo} {x.Curso} {x.Seccion} {x.Tipo.GetDisplayName()} {limite} {x.Entregadas} {x.Pendientes} {x.Estado.GetDisplayName()}")">
                <div class="card-body">
                    <div class="d-flex justify-content-between gap-2">
                        <div class="fw-bold">@x.Titulo</div>
                        <span class="app-badge @claseEstado">@x.Estado.GetDisplayName()</span>
                    </div>
                    <div class="text-muted mb-3">@x.Curso · @x.Seccion</div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <span class="small text-muted d-block">Tipo</span>
                            @x.Tipo.GetDisplayName()
                        </div>
                        <div class="col-6">
                            <span class="small text-muted d-block">Límite</span>
                            @limite
                        </div>
                        <div class="col-12">
                            <span class="small text-muted d-block">Seguimiento</span>
                            @x.Entregadas entregadas / @x.Pendientes pendientes
                        </div>
                        <div class="col-12">
                            <span class="small text-muted d-block">Disponibilidad</span>
                            @disponibilidad
                        </div>
                    </div>

                    @if (!soloLectura ||
                         (reabrir && x.PuedeReabrirse &&
                          x.Estado == Proyecto_Final.Models.EstadoTarea.Cerrada))
                    {
                        <div class="d-grid gap-2">
                            @if (e && (esBorrador || esPublicada))
                            {
                                <a asp-action="Editar" asp-route-id="@x.Id" class="app-btn app-btn-soft-secondary">Editar</a>
                            }
                            @if (cuest && x.Tipo == Proyecto_Final.Models.TipoTarea.Cuestionario && esBorrador)
                            {
                                <a asp-controller="Cuestionarios" asp-action="Configurar" asp-route-tareaId="@x.Id"
                                   class="app-btn app-btn-soft-secondary">Continuar configuración</a>
                            }
                            @if (p && esBorrador)
                            {
                                <form asp-action="Publicar" asp-route-id="@x.Id" method="post" data-confirmar-accion-academica
                                      data-confirmar-titulo="Publicar tarea"
                                      data-confirmar-mensaje="La tarea se habilitará para los alumnos vigentes de la sección."
                                      data-confirmar-texto="Publicar" data-confirmar-color="#198754">
                                    @Html.AntiForgeryToken()
                                    <button class="app-btn app-btn-soft-success w-100">Publicar</button>
                                </form>
                            }
                            @if (cerrar && esPublicada)
                            {
                                <a asp-action="Cerrar" asp-route-id="@x.Id" class="app-btn app-btn-soft-danger w-100">Cerrar</a>
                            }
                            @if (reabrir && x.PuedeReabrirse &&
                                (!soloLectura || x.Estado == Proyecto_Final.Models.EstadoTarea.Cerrada))
                            {
                                <a asp-action="Reabrir" asp-route-id="@x.Id" class="app-btn app-btn-soft-warning">Reabrir para
                                    todos
                                </a>
                            }
                        </div>
                    }
                </div>
            </article>
        }
    </div>
    <p class="text-muted text-center py-3 d-none" data-sin-tareas-movil>
        No se encontraron tareas.
    </p>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
        <span class="small text-muted" data-contador-tareas-movil></span>
        <div class="d-flex gap-2">
            <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm" data-anterior-tareas-movil>
                Anterior
            </button>
            <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm" data-siguiente-tareas-movil>
                Siguiente
            </button>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/acciones-academicas.js" asp-append-version="true"></script>
    <script src="~/js/tareas-index.js" asp-append-version="true"></script>
}
