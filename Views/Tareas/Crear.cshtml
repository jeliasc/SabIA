@model Proyecto_Final.ViewModels.Tareas.CrearTarea

@{
    ViewData["Title"] = "Nueva tarea";
    var esCuestionario = Model.Tipo == Proyecto_Final.Models.TipoTarea.Cuestionario;
}

<div class="container-fluid">
    <h2 class="fw-bold mb-4">
        Nueva tarea
    </h2>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post"
                  enctype="multipart/form-data"
                  data-formulario-tarea>
                @Html.AntiForgeryToken()
                <input asp-for="TokenCreacion" type="hidden" />

                <partial name="Formulario" model="Model" />

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index"
                       class="app-btn app-btn-secondary">
                        Cancelar
                    </a>

                    <button class="app-btn app-btn-soft-primary"
                            data-accion-tarea>
                        <span data-texto-accion-tarea>
                            @(esCuestionario ? "Configurar cuestionario" : "Guardar borrador")
                        </span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/tareas-formulario.js" asp-append-version="true"></script>
}
