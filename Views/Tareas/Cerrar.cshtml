@model Proyecto_Final.ViewModels.Tareas.CerrarTarea

@{
    ViewData["Title"] = "Cerrar tarea";
}

<div class="container-fluid">
    <h2 class="fw-bold mb-1">Cerrar tarea</h2>
    <p class="text-muted mb-4">@Model.Titulo · @Model.Curso</p>
    <div class="app-alert app-alert-warning mb-4">
        El cierre administrativo detendrá las entregas ordinarias. Hay
        <strong>@Model.AlumnosSinActividad alumno(s)</strong> sin entrega ni intento registrado.
    </div>
    <div class="card border-0 shadow-sm"><div class="card-body p-4">
        <form method="post" data-confirmar-accion-academica
              data-confirmar-titulo="Cerrar tarea"
              data-confirmar-mensaje="Revise la opción seleccionada antes de confirmar."
              data-confirmar-texto="Cerrar tarea">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" asp-for="CalificarSinActividad" value="false" />
                <label class="form-check-label" for="CalificarSinActividad">Cerrar y conservar pendientes</label>
                <div class="form-text">No se modifican las notas de quienes no realizaron la actividad.</div>
            </div>
            <div class="form-check mb-4">
                <input class="form-check-input" type="radio" asp-for="CalificarSinActividad" value="true"
                       disabled="@(!Model.PuedeCalificarAutomaticamente)" />
                <label class="form-check-label" for="CalificarSinActividad">Cerrar y calificar con cero a @Model.AlumnosSinActividad alumno(s) sin actividad</label>
                @if (!Model.PuedeCalificarAutomaticamente)
                {
                    <div class="form-text text-danger">Su perfil puede cerrar tareas, pero no calificar entregas.</div>
                }
            </div>
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="app-btn app-btn-secondary">Cancelar</a>
                <button type="submit" class="app-btn app-btn-soft-danger">Confirmar cierre</button>
            </div>
        </form>
    </div></div>
</div>
