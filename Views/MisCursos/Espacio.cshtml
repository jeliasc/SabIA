@model Proyecto_Final.ViewModels.NavegacionAcademica.EspacioCurso
@{
    ViewData["Title"] = Model.Contexto.Curso;
}
<div class="container-fluid">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-action="Index">@(Model.Contexto.EsDocente ? "Mis asignaciones" : "Mis cursos")</a>
            </li>
            <li class="breadcrumb-item active">@Model.Contexto.Curso</li>
        </ol>
    </nav>
    <div class="mb-4">
        <h2 class="fw-bold mb-1">@Model.Contexto.Curso</h2>
        <p class="text-muted mb-0">@Model.Contexto.Grado · Sección @Model.Contexto.Seccion · Ciclo
            @Model.Contexto.Anio
            @if (!Model.Contexto.EsDocente)
            {
                <text> · @Model.Contexto.Docente</text>
            }
        </p>
    </div>
    <partial name="_NavbarCurso" model="Model" />
</div>
