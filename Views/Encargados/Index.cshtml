@model IEnumerable<Proyecto_Final.ViewModels.Encargados.EncargadoLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService Autorizacion

@{
    ViewData["Title"] = "Encargados";
    var puedeCrear = (await Autorizacion.AuthorizeAsync(User, Permisos.Encargados.Crear)).Succeeded;
    var puedeEditar = (await Autorizacion.AuthorizeAsync(User, Permisos.Encargados.Editar)).Succeeded;
}
<div class="container-fluid">
    <partial name="_AlertasResultado" />
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Encargados</h2>
            <p class="text-muted mb-0">Información de contacto de responsables vinculados a los alumnos.</p>
        </div>
        @if (puedeCrear)
        {
            <a asp-action="Crear" class="app-btn app-btn-soft-primary">Nuevo encargado</a>
        }
    </div>
    <div class="d-md-none mb-3">
        <input type="search" class="form-control" placeholder="Buscar encargado..."
               data-filtro-tarjetas="[data-encargado]" data-sin-resultados="[data-sin-encargados]" />
    </div>
    <div class="card shadow-sm border border-secondary d-none d-md-block">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table app-table w-100" data-tabla-index data-actions-column="true"
                       data-search-placeholder="Nombre, DPI, teléfono o correo..."
                       data-empty-message="No existen encargados registrados"
                       data-zero-message="No se encontraron encargados">
                    <thead>
                        <tr>
                            <th>Encargado</th>
                            <th>DPI</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th>Alumnos</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@x.NombreCompleto</td>
                                <td>@(x.Dpi ?? "Sin registrar")</td>
                                <td>@x.Telefono</td>
                                <td>@(x.Correo ?? "Sin registrar")</td>
                                <td>@x.Alumnos</td>
                                <td class="app-actions-cell">@if (puedeEditar) {
                                    <a asp-action="Editar" asp-route-id="@x.Id"
                                       class="app-btn app-btn-soft-secondary app-btn-sm">Editar</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="d-md-none">
    @foreach (var x in Model)
    {
        <div class="card shadow-sm border-0 mb-3" data-encargado
             data-texto-busqueda="@($"{x.NombreCompleto} {x.Dpi} {x.Telefono} {x.Correo}")">
            <div class="card-body p-4">
                <div class="fw-bold fs-5">@x.NombreCompleto</div>
                <div class="text-muted small mb-3">@(x.Dpi ?? "DPI sin registrar")</div>
                <div class="mb-1"><b>Teléfono:</b> @x.Telefono</div>
                <div class="mb-1"><b>Correo:</b> @(x.Correo ?? "Sin registrar")</div>
                <div class="mb-3"><b>Alumnos vinculados:</b> @x.Alumnos</div>
                @if (puedeEditar)
                {
                    <a asp-action="Editar" asp-route-id="@x.Id"
                       class="app-btn app-btn-soft-secondary w-100">Editar</a>
                }
            </div>
        </div>
    }
    <div class="app-card d-none" data-sin-encargados>
        <div class="app-card-body text-center text-muted">No se encontraron encargados.</div>
    </div>
</div>
</div>
@section Scripts {
    <script src="~/js/modulos-academicos.js" asp-append-version="true"></script>
}
