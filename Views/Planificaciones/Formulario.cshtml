@model Proyecto_Final.ViewModels.Planificaciones.FormularioPlanificacion

<div asp-validation-summary="ModelOnly" class="text-danger mb-3">
</div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Tipo" class="form-label">
            Tipo
        </label>

        <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<Proyecto_Final.Models.TipoPlanificacion>()"
                class="form-select">
        </select>
    </div>

    <div class="col-md-8">
        <label asp-for="Titulo" class="form-label">
            Título
        </label>

        <input asp-for="Titulo" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="AsignacionId" class="form-label">
            Asignación
        </label>

        <select asp-for="AsignacionId" class="form-select" data-select-busqueda>
            <option value="">Seleccione...</option>

            @foreach (var x in Model.Asignaciones)
            {
                <option value="@x.Id">
                    @x.Texto
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label asp-for="PeriodoId" class="form-label">
            Período
        </label>

        <select asp-for="PeriodoId" class="form-select" data-select-busqueda>
            <option value="">Opcional</option>

            @foreach (var x in Model.Periodos)
            {
                <option value="@x.Id">
                    @x.Texto
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label asp-for="UnidadAsignacionId" class="form-label">
            Unidad
        </label>

        <select asp-for="UnidadAsignacionId" class="form-select" data-select-busqueda>
            <option value="">Opcional</option>

            @foreach (var x in Model.Unidades)
            {
                <option value="@x.Id">
                    @x.Texto
                </option>
            }
        </select>
    </div>

    <div class="col-md-6">
        <label asp-for="FechaInicio" class="form-label">
            Inicio
        </label>

        <input asp-for="FechaInicio" type="date" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="FechaFin" class="form-label">
            Fin
        </label>

        <input asp-for="FechaFin" type="date" class="form-control" />
    </div>

    <div class="col-12">
        <label asp-for="Objetivos" class="form-label">
            Objetivos
        </label>

        <textarea asp-for="Objetivos" class="form-control" rows="2">
        </textarea>
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label">
            Descripción
        </label>

        <textarea asp-for="Descripcion" class="form-control" rows="2">
        </textarea>
    </div>

    <div class="col-12">
        <label asp-for="Contenido" class="form-label">
            Contenido / temario
        </label>

        <textarea asp-for="Contenido" class="form-control" rows="6">
        </textarea>

        <span asp-validation-for="Contenido" class="text-danger">
        </span>
    </div>

    <div class="col-md-6">
        <label asp-for="Actividades" class="form-label">
            Actividades
        </label>

        <textarea asp-for="Actividades" class="form-control" rows="3">
        </textarea>
    </div>

    <div class="col-md-6">
        <label asp-for="Recursos" class="form-label">
            Recursos
        </label>

        <textarea asp-for="Recursos" class="form-control" rows="3">
        </textarea>
    </div>

    <div class="col-12">
        <label asp-for="EstrategiaEvaluacion" class="form-label">
            Estrategia de evaluación
        </label>

        <textarea asp-for="EstrategiaEvaluacion" class="form-control" rows="3">
        </textarea>
    </div>

    <div class="col-12">
        <label asp-for="Archivo" class="form-label">
            Planificación en PDF para generación con IA (opcional)
        </label>

        <input asp-for="Archivo" type="file" accept="application/pdf,.pdf" class="form-control" />
    </div>
</div>
