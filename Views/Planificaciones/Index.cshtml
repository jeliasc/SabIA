@model IEnumerable<Proyecto_Final.ViewModels.Planificaciones.PlanificacionLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService A

@{
    var soloLectura = ViewData["SoloLectura"] as bool? ?? false;

    ViewData["Title"] = soloLectura
        ? "Historial de planificaciones"
        : "Planificaciones";

    var c = (await A.AuthorizeAsync(
        User,
        Permisos.Planificaciones.Crear
    )).Succeeded;

    var e = (await A.AuthorizeAsync(
        User,
        Permisos.Planificaciones.Editar
    )).Succeeded;

    var enviar = (await A.AuthorizeAsync(
        User,
        Permisos.Planificaciones.EnviarRevision
    )).Succeeded;

    var revisar = (await A.AuthorizeAsync(
        User,
        Permisos.Planificaciones.Revisar
    )).Succeeded;

    var ia = (await A.AuthorizeAsync(
        User,
        Permisos.ContenidoIA.Generar
    )).Succeeded;

    var puedeVer = (await A.AuthorizeAsync(
        User,
        Permisos.Planificaciones.Ver
    )).Succeeded;

    // Actualmente no hemos confirmado que exista un permiso
    // independiente de descarga. Usamos Ver y mantenemos
    // la validación de acceso académico en el servidor.
    var puedeDescargar = puedeVer;

    var hayAcciones = Model.Any(x =>
    (x.TienePdf && puedeVer) ||
    (!soloLectura &&
        (
            ((x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Borrador ||
              x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Devuelta) &&
              (e || enviar)) ||
            (x.Estado == Proyecto_Final.Models.EstadoPlanificacion.EnRevision && revisar) ||
            ia
        )));
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                @(soloLectura ? "Historial de planificaciones" : "Planificaciones")
            </h2>

            <p class="text-muted mb-0">
                Planificación académica, revisión y base para contenido con IA.
            </p>
        </div>

        <div class="d-grid d-md-flex align-items-center gap-2">
            @if (!soloLectura && c)
            {
                <a asp-action="Crear" class="app-btn app-btn-soft-primary">
                    Nueva planificación
                </a>
            }
            <a asp-action="@(soloLectura ? "Index" : "Historial")" class="app-btn app-btn-soft-secondary">
                @(soloLectura ? "Ver vigentes" : "Ver historial")
            </a>
        </div>
    </div>

    <div class="card shadow-sm border border-secondary d-none d-lg-block">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table app-table w-100" data-tabla-index
                       data-actions-column="@(hayAcciones ? "true" : "false")">
                    <thead>
                        <tr>
                            <th>Planificación</th>
                            <th>Curso</th>
                            <th>Docente</th>
                            <th>Tipo / Versión</th>
                            <th>Estado</th>
                            @if (hayAcciones)
                            {
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @x.Titulo
                                </td>

                                <td>@x.Curso</td>

                                <td>@x.Docente</td>

                                <td class="text-nowrap">
                                    @x.Tipo.GetDisplayName() · V@(x.Version)
                                </td>

                                <td>
                                    <span class="app-badge  text-nowrap @(x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Aprobada
                                              ? "app-badge-success"
                                              : x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Devuelta
                                                ? "app-badge-danger"
                                                : "app-badge-secondary")">
                                        @x.Estado.GetDisplayName()
                                    </span>
                                </td>

                                @if (hayAcciones)
                                {
                                    <td>
                                        <div class="app-actions d-flex flex-nowrap align-items-center gap-2 text-nowrap">
                                            @if (x.TienePdf && puedeVer)
                                            {
                                                <a asp-action="Visualizar" asp-route-id="@x.Id"
                                                   class="app-btn app-btn-soft-success app-btn-sm" target="_blank" rel="noopener">
                                                    Visualizar
                                                </a>

                                                @if (puedeDescargar)
                                                {
                                                    <a asp-action="Descargar" asp-route-id="@x.Id"
                                                       class="app-btn app-btn-soft-primary app-btn-sm">
                                                        Descargar
                                                    </a>
                                                }
                                            }
                                            @if (!soloLectura && e &&
                                                (x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Borrador ||
                                                 x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Devuelta))
                                            {
                                                <a asp-action="Editar" asp-route-id="@x.Id"
                                                   class="app-btn app-btn-soft-secondary app-btn-sm">
                                                    Editar
                                                </a>
                                            }

                                            @if (!soloLectura && enviar &&
                                                (x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Borrador ||
                                                 x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Devuelta))
                                            {
                                                <form asp-action="EnviarRevision" asp-route-id="@x.Id" method="post"
                                                      data-confirmar-accion-academica data-confirmar-titulo="Enviar a revisión"
                                                      data-confirmar-mensaje="La planificación quedará pendiente de revisión y no podrá editarse mientras esté en ese estado."
                                                      data-confirmar-texto="Enviar" data-confirmar-color="#198754">
                                                    @Html.AntiForgeryToken()

                                                    <button class="app-btn app-btn-soft-primary app-btn-sm">
                                                        Enviar a revisión
                                                    </button>
                                                </form>
                                            }

                                            @if (!soloLectura && revisar &&
                                                x.Estado == Proyecto_Final.Models.EstadoPlanificacion.EnRevision)
                                            {
                                                <a asp-action="Revisar" asp-route-id="@x.Id"
                                                   class="app-btn app-btn-soft-success app-btn-sm">
                                                    Revisar
                                                </a>
                                            }

                                            @if (!soloLectura && ia)
                                            {
                                                <a asp-controller="ContenidoIA" asp-action="Generar"
                                                   asp-route-planificacionId="@x.Id"
                                                   class="app-btn app-btn-soft-secondary app-btn-sm">
                                                    Generar IA
                                                </a>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Vista móvil de planificaciones -->
<div class="d-lg-none" id="planificacionesMovil">

    <div class="mb-3">
        <div class="d-grid">
            <button type="button" class="app-btn app-btn-secondary" aria-expanded="false"
                    aria-controls="busqueda-planificaciones-movil" data-mostrar-busqueda-planificaciones>
                <i class="bi bi-search" aria-hidden="true"></i>
                Buscar planificación
            </button>
        </div>

        <div id="busqueda-planificaciones-movil" class="mt-2 d-none" data-contenedor-busqueda-planificaciones>

            <input type="search" id="buscarPlanificacionMovil" class="form-control"
                   placeholder="Título, curso, docente, tipo o estado..." aria-label="Buscar planificaciones"
                   autocomplete="off" data-busqueda-planificaciones />
        </div>
    </div>

    <div id="listaPlanificacionesMovil">
        @foreach (var x in Model)
        {
            <div class="card border rounded-3 mb-3 planificacion-movil-item"
                 data-busqueda="@($"{x.Titulo} {x.Curso} {x.Docente} {x.Tipo.GetDisplayName()} {x.Estado.GetDisplayName()}".ToLowerInvariant())">

                <div class="card-body">

                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                        <div class="fw-semibold">
                            @x.Titulo
                        </div>

                        <span class="app-badge text-nowrap @(x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Aprobada
                              ? "app-badge-success"
                              : x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Devuelta
                                ? "app-badge-danger"
                                : "app-badge-secondary")">
                            @x.Estado.GetDisplayName()
                        </span>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted">Curso:</span>
                        <span class="fw-medium">@x.Curso</span>
                    </div>

                    <div class="mb-2">
                        <span class="text-muted">Docente:</span>
                        <span class="fw-medium">@x.Docente</span>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted">Tipo / Versión:</span>
                        <span>@x.Tipo.GetDisplayName() · V@(x.Version)</span>
                    </div>

                    @if ((x.TienePdf && puedeVer) ||
                         (!soloLectura &&
                            (((x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Borrador ||
                               x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Devuelta) && (e || enviar)) ||
                             (x.Estado == Proyecto_Final.Models.EstadoPlanificacion.EnRevision && revisar) ||
                             ia)))
                    {
                        <div class="d-grid gap-2">

                            @if (x.TienePdf && puedeVer)
                            {
                                <a asp-action="Visualizar" asp-route-id="@x.Id" target="_blank" rel="noopener"
                                   class="app-btn app-btn-soft-success app-btn-sm">
                                    Visualizar PDF
                                </a>

                                @if (puedeDescargar)
                                {
                                    <a asp-action="Descargar" asp-route-id="@x.Id" class="app-btn app-btn-soft-primary app-btn-sm">
                                        Descargar PDF
                                    </a>
                                }
                            }

                            @if (!soloLectura && e &&
                                (x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Borrador ||
                                 x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Devuelta))
                            {
                                <a asp-action="Editar" asp-route-id="@x.Id" class="app-btn app-btn-soft-secondary app-btn-sm">
                                    Editar
                                </a>
                            }

                            @if (!soloLectura && enviar &&
                                (x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Borrador ||
                                 x.Estado == Proyecto_Final.Models.EstadoPlanificacion.Devuelta))
                            {
                                <form asp-action="EnviarRevision" asp-route-id="@x.Id" method="post" data-confirmar-accion-academica
                                      data-confirmar-titulo="Enviar a revisión"
                                      data-confirmar-mensaje="La planificación quedará pendiente de revisión y no podrá editarse mientras esté en ese estado."
                                      data-confirmar-texto="Enviar" data-confirmar-color="#198754">

                                    @Html.AntiForgeryToken()

                                    <button type="submit" class="app-btn app-btn-soft-primary app-btn-sm w-100">
                                        Enviar a revisión
                                    </button>
                                </form>
                            }

                            @if (!soloLectura && revisar &&
                                x.Estado == Proyecto_Final.Models.EstadoPlanificacion.EnRevision)
                            {
                                <a asp-action="Revisar" asp-route-id="@x.Id" class="app-btn app-btn-soft-success app-btn-sm">
                                    Revisar
                                </a>
                            }

                            @if (!soloLectura && ia)
                            {
                                <a asp-controller="ContenidoIA" asp-action="Generar" asp-route-planificacionId="@x.Id"
                                   class="app-btn app-btn-soft-secondary app-btn-sm">
                                    Generar IA
                                </a>
                            }

                        </div>
                    }

                </div>
            </div>
        }
    </div>

    <p id="sinPlanificacionesMovil" class="text-muted text-center py-3 d-none">
        No se encontraron planificaciones.
    </p>

    <div class="d-flex justify-content-between align-items-center gap-2 mt-3">
        <span id="contadorPlanificacionesMovil" class="small text-muted"></span>

        <div class="d-flex gap-2">
            <button type="button" id="anteriorPlanificacionesMovil" class="app-btn app-btn-soft-secondary app-btn-sm">
                Anterior
            </button>

            <button type="button" id="siguientePlanificacionesMovil" class="app-btn app-btn-soft-secondary app-btn-sm">
                Siguiente
            </button>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/acciones-academicas.js" asp-append-version="true"></script>
    <script src="~/js/planificaciones-index.js" asp-append-version="true"></script>
}
