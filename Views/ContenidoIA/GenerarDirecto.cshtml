@model Proyecto_Final.ViewModels.ContenidoIA.GenerarContenidoDirectoIa
@{
    ViewData["Title"] = "Generación directa con IA";
}
<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Generación directa con IA</h2>
        <p class="text-muted mb-0">El resultado se mantiene en revisión hasta que un docente decida usarlo.</p>
    </div>
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="GenerarDirecto" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Prompt" class="form-label">Instrucción</label>
                    <textarea asp-for="Prompt" class="form-control" rows="6" placeholder="Describa el contenido que necesita"></textarea>
                    <span asp-validation-for="Prompt" class="text-danger"></span>
                </div>
                <div class="mb-4 col-md-3 ps-0">
                    <label asp-for="MaxTokens" class="form-label">Máximo de tokens</label>
                    <input asp-for="MaxTokens" class="form-control" min="1" />
                    <span asp-validation-for="MaxTokens" class="text-danger"></span>
                </div>
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <a asp-action="Generar" class="app-btn app-btn-secondary">Volver al PDF</a>
                    <button class="app-btn app-btn-soft-primary" type="submit"><i class="bi bi-stars"></i> Generar contenido</button>
                </div>
            </form>
        </div>
    </div>
</div>
