@model Proyecto_Final.ViewModels.ContenidoIA.GenerarContenidoIa
@{
    ViewData["Title"] = "Generar contenido con IA";
}
<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Generar contenido con IA</h2>
        <p class="text-muted mb-0">Seleccione exactamente un documento de origen y defina los materiales que desea solicitar.</p>
    </div>
    <div class="app-alert app-alert-info mb-4">El contenido generado debe ser revisado por el docente antes de
        publicarse a los alumnos.
    </div>
    <partial name="Generar" model="Model" />
</div>

@* Los scripts de una vista parcial no se ejecutan; se cargan aquí. *@
@section Scripts {
    <script src="~/js/contenido-ia-origen.js" asp-append-version="true"></script>
}
