@model Proyecto_Final.ViewModels.ContenidoIA.TrabajosContenidoIa
@{
    ViewData["Title"] = "Generación con IA";
}
<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Generación en proceso</h2>
        <p class="text-muted mb-0">@Model.Planificacion</p>
    </div>
    <div class="row g-3" data-trabajos-ia>
        @foreach (var trabajo in Model.Trabajos)
        {
            <div class="col-12" data-trabajo-ia data-job-id="@trabajo.JobId">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
                            <div>
                                <div class="fw-bold text-capitalize">@trabajo.Tipo.Replace("_", " ")</div>
                                <div class="small text-muted">@trabajo.JobId</div>
                            </div><span class="app-badge app-badge-secondary" data-estado>Consultando...</span>
                        </div>
                        <div class="d-none" data-resultado>
                            <pre class="mb-0 text-wrap"></pre>
                        </div>
                        <div class="text-danger d-none" data-error></div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="mt-4"><a asp-action="Generar" class="app-btn app-btn-secondary">Nueva generación</a></div>
</div>
@section Scripts {
    <script src="~/js/contenido-ia.js" asp-append-version="true"></script>
}