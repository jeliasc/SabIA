@model Proyecto_Final.ViewModels.Cuestionarios.CrearPregunta

@{
    ViewData["Title"] = "Agregar pregunta";
}

<div class="container-fluid">
    <h2 class="fw-bold mb-1">
        Agregar pregunta
    </h2>

    <p class="text-muted mb-4">
        @Model.Cuestionario
    </p>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post">
                @Html.AntiForgeryToken()

                <input asp-for="CuestionarioId" type="hidden" />
                <input asp-for="Cuestionario" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="row g-3">
                    <div class="col-md-2">
                        <label asp-for="Orden"
                               class="form-label">
                            Orden
                        </label>

                        <input asp-for="Orden"
                               class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Tipo"
                               class="form-label">
                            Tipo
                        </label>

                        <select asp-for="Tipo"
                                asp-items="Html.GetEnumSelectList<Proyecto_Final.Models.TipoPregunta>()"
                                class="form-select">
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="Punteo"
                               class="form-label">
                            Punteo
                        </label>

                        <input asp-for="Punteo"
                               class="form-control" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Enunciado"
                               class="form-label">
                            Pregunta
                        </label>

                        <textarea asp-for="Enunciado"
                                  class="form-control"
                                  rows="3">
                        </textarea>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="OpcionesSeparadas"
                               class="form-label">
                            Opciones
                        </label>

                        <textarea asp-for="OpcionesSeparadas"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Una opción por línea">
                        </textarea>

                        <div class="form-text">
                            Para Verdadero/Falso se generan automáticamente.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="RespuestaCorrecta"
                               class="form-label">
                            Respuesta correcta
                        </label>

                        <textarea asp-for="RespuestaCorrecta"
                                  class="form-control"
                                  rows="5">
                        </textarea>

                        <div class="form-text">
                            En selección debe coincidir exactamente con una de las opciones.
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-md-row justify-content-end gap-2 mt-4">
                    <a asp-action="Index"
                       class="app-btn app-btn-secondary">
                        Finalizar
                    </a>

                    <button class="app-btn app-btn-soft-primary">
                        Guardar y agregar otra
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>