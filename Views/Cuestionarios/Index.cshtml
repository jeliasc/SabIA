@model IEnumerable<Proyecto_Final.ViewModels.Cuestionarios.CuestionarioLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService A

@{
    ViewData["Title"] = "Cuestionarios";

    var editar = (await A.AuthorizeAsync(
        User,
        Permisos.Cuestionarios.Editar
    )).Succeeded;

    var resolver = (await A.AuthorizeAsync(
        User,
        Permisos.Cuestionarios.Resolver
    )).Succeeded;
    var soloLectura = ViewData["SoloLectura"] as bool? ?? false;
    var hayAcciones = Model.Any(x =>
        (x.PuedeVerResultados &&
         x.EstadoTarea != Proyecto_Final.Models.EstadoTarea.Borrador) ||
        (!soloLectura &&
         ((editar && x.EstadoTarea == Proyecto_Final.Models.EstadoTarea.Borrador) ||
          (resolver && x.EstadoTarea == Proyecto_Final.Models.EstadoTarea.Publicada))));
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Cuestionarios
            </h2>

            <p class="text-muted mb-0">
                Cuestionarios manuales o generados con apoyo de IA.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (editar && !soloLectura)
            {
                <a asp-action="ImportarIa" class="app-btn app-btn-soft-secondary">
                    <i class="bi bi-stars"></i> Importar desde IA
                </a>
            }
            <a asp-action="@(soloLectura ? "Index" : "Historial")" class="app-btn app-btn-soft-primary">
                @(soloLectura ? "Ver vigentes" : "Ver historial")
            </a>
        </div>
    </div>

    <div class="card shadow-sm border border-secondary d-none d-md-block">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table app-table w-100" data-tabla-index
                       data-actions-column="@(hayAcciones ? "true" : "false")">
                    <thead>
                        <tr>
                            <th>Cuestionario</th>
                            <th>Curso</th>
                            <th>Preguntas</th>
                            <th>Intentos</th>
                            <th>Origen</th>
                            <th>Estado</th>
                            @if (hayAcciones)
                            {
                                <th>Acciones</th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var x in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @x.Tarea
                                </td>

                                <td>@x.Curso</td>

                                <td>@x.Preguntas</td>

                                <td>
                                    @(x.MaximoIntentos == 0
                                        ? "Sin límite"
                                        : x.MaximoIntentos)
                                </td>

                                <td>@x.Origen.GetDisplayName()</td>

                                <td>@x.EstadoTarea.GetDisplayName()</td>

                                @if (hayAcciones)
                                {
                                <td>
                                    <div class="app-actions app-actions-table">
                                        @if (editar &&
                                            x.EstadoTarea == Proyecto_Final.Models.EstadoTarea.Borrador)
                                        {
                                            <a asp-action="AgregarPregunta" asp-route-cuestionarioId="@x.Id"
                                               class="app-btn app-btn-soft-secondary app-btn-sm">
                                                Preguntas
                                            </a>
                                        }

                                        @if (x.PuedeVerResultados &&
                                            x.EstadoTarea != Proyecto_Final.Models.EstadoTarea.Borrador)
                                        {
                                            <a asp-action="Resultados" asp-route-id="@x.Id"
                                               class="app-btn app-btn-soft-secondary app-btn-sm">
                                                Resultados
                                            </a>
                                        }

                                        @if (resolver &&
                                            x.EstadoTarea == Proyecto_Final.Models.EstadoTarea.Publicada)
                                        {
                                            <a asp-action="Resolver" asp-route-id="@x.Id"
                                               class="app-btn app-btn-soft-primary app-btn-sm">
                                                Resolver
                                            </a>
                                        }
                                    </div>
                                </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-md-none" id="cuestionariosMovil">
        <div class="mb-3">
            <div class="d-grid">
                <button type="button" class="app-btn app-btn-secondary"
                        aria-expanded="false" aria-controls="busqueda-cuestionarios-movil"
                        data-mostrar-busqueda-cuestionarios>
                    <i class="bi bi-search" aria-hidden="true"></i>
                    Buscar cuestionario
                </button>
            </div>
            <div id="busqueda-cuestionarios-movil" class="mt-2 d-none"
                 data-contenedor-busqueda-cuestionarios>
                <input type="search" id="buscarCuestionarioMovil" class="form-control"
                       placeholder="Cuestionario, curso, origen o estado..."
                       aria-label="Buscar cuestionarios" autocomplete="off" />
            </div>
        </div>

        <div data-lista-cuestionarios-movil>
            @foreach (var x in Model)
            {
                var esBorrador = x.EstadoTarea == Proyecto_Final.Models.EstadoTarea.Borrador;
                var esPublicada = x.EstadoTarea == Proyecto_Final.Models.EstadoTarea.Publicada;
                var intentos = x.MaximoIntentos == 0 ? "Sin límite" : x.MaximoIntentos.ToString();

                <article class="card shadow-sm border-0 mb-3 cuestionario-movil-item"
                         data-busqueda="@($"{x.Tarea} {x.Curso} {x.Preguntas} {intentos} {x.Origen.GetDisplayName()} {x.EstadoTarea.GetDisplayName()}")">
                    <div class="card-body">
                        <div class="fw-bold">@x.Tarea</div>
                        <div class="text-muted mb-3">@x.Curso</div>
                        <div class="row g-2 mb-3">
                            <div class="col-4"><span class="small text-muted d-block">Preguntas</span>@x.Preguntas</div>
                            <div class="col-4"><span class="small text-muted d-block">Intentos</span>@intentos</div>
                            <div class="col-4"><span class="small text-muted d-block">Origen</span>@x.Origen.GetDisplayName()</div>
                        </div>
                        <div class="mb-3"><span class="app-badge app-badge-secondary">@x.EstadoTarea.GetDisplayName()</span></div>
                        <div class="d-grid gap-2">
                            @if (!soloLectura && editar && esBorrador)
                            {
                                <a asp-action="AgregarPregunta" asp-route-cuestionarioId="@x.Id"
                                   class="app-btn app-btn-soft-secondary">Preguntas</a>
                            }
                            @if (x.PuedeVerResultados && !esBorrador)
                            {
                                <a asp-action="Resultados" asp-route-id="@x.Id"
                                   class="app-btn app-btn-soft-secondary">Resultados</a>
                            }
                            @if (!soloLectura && resolver && esPublicada)
                            {
                                <a asp-action="Resolver" asp-route-id="@x.Id"
                                   class="app-btn app-btn-soft-primary">Resolver</a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>

        <p class="text-muted text-center py-3 d-none" data-sin-cuestionarios-movil>
            No se encontraron cuestionarios.
        </p>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
            <span class="small text-muted" data-contador-cuestionarios-movil></span>
            <div class="d-flex gap-2">
                <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm"
                        data-anterior-cuestionarios-movil>Anterior</button>
                <button type="button" class="app-btn app-btn-soft-secondary app-btn-sm"
                        data-siguiente-cuestionarios-movil>Siguiente</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cuestionarios-index.js" asp-append-version="true"></script>
}
