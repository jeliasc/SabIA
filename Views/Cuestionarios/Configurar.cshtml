@model Proyecto_Final.ViewModels.Cuestionarios.ConfigurarCuestionario

@{
    ViewData["Title"] = "Configurar cuestionario";
}

<div class="container-fluid">
    <h2 class="fw-bold mb-1">
        Configurar cuestionario
    </h2>

    <p class="text-muted mb-4">
        @Model.Tarea
    </p>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post">
                @Html.AntiForgeryToken()

                <input asp-for="TareaId" type="hidden" />
                <input asp-for="Tarea" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="MaximoIntentos"
                               class="form-label">
                            Máximo de intentos
                        </label>

                        <input asp-for="MaximoIntentos"
                               class="form-control" />

                        <div class="form-text">
                            Use 0 para intentos ilimitados.
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CriterioCalificacion"
                               class="form-label">
                            Criterio de calificación
                        </label>

                        <select asp-for="CriterioCalificacion"
                                asp-items="Html.GetEnumSelectList<Proyecto_Final.Models.CriterioCalificacionIntentos>()"
                                class="form-select">
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ModalidadTiempo"
                               class="form-label">
                            Tiempo
                        </label>

                        <select asp-for="ModalidadTiempo"
                                asp-items="Html.GetEnumSelectList<Proyecto_Final.Models.ModalidadTiempoCuestionario>()"
                                class="form-select">
                        </select>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="MostrarResultadosAlFinalizar"
                                   class="form-check-input" />

                            <label asp-for="MostrarResultadosAlFinalizar"
                                   class="form-check-label">
                                Mostrar resultado al finalizar
                            </label>
                        </div>

                        <div class="form-check">
                            <input asp-for="MostrarRespuestasCorrectas"
                                   class="form-check-input" />

                            <label asp-for="MostrarRespuestasCorrectas"
                                   class="form-check-label">
                                Mostrar respuestas correctas
                            </label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Tareas"
                       asp-action="Index"
                       class="app-btn app-btn-secondary">
                        Cancelar
                    </a>

                    <button class="app-btn app-btn-soft-primary">
                        Guardar y agregar preguntas
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>