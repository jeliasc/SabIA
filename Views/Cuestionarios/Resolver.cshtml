@model Proyecto_Final.ViewModels.Cuestionarios.ResolverCuestionario
@using Proyecto_Final.Models
@{
    ViewData["Title"] = "Resolver cuestionario";
}
<div class="container-fluid">
    <h2 class="fw-bold mb-1">@Model.Titulo</h2>
    <p class="text-muted mb-4">Intentos utilizados: @Model.IntentosUsados · Máximo: @(Model.MaximoIntentos == 0 ? "Sin límite" : Model.MaximoIntentos)</p>

    <form method="post">
        @Html.AntiForgeryToken()
        <input asp-for="CuestionarioId" type="hidden" />

        @for (var i = 0; i < Model.Respuestas.Count; i++)
        {
            <input asp-for="Respuestas[i].PreguntaId" type="hidden" />
            <input asp-for="Respuestas[i].Orden" type="hidden" />
            <input asp-for="Respuestas[i].Tipo" type="hidden" />

            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body p-4">
                    <div class="fw-semibold mb-3">@Model.Respuestas[i].Orden. @Model.Respuestas[i].Enunciado</div>

                    @if (Model.Respuestas[i].Opciones.Count > 0)
                    {
                        foreach (var opcion in Model.Respuestas[i].Opciones)
                        {
                            var esMultiple = Model.Respuestas[i].Tipo == TipoPregunta.SeleccionMultiple;
                            <div class="form-check mb-2">
                                @if (esMultiple)
                                {
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="Respuestas[@i].OpcionIds"
                                           value="@opcion.Id"
                                           id="o_@(i)_@opcion.Id" />
                                }
                                else
                                {
                                    <input class="form-check-input"
                                           type="radio"
                                           name="Respuestas[@i].OpcionId"
                                           value="@opcion.Id"
                                           id="o_@(i)_@opcion.Id" />
                                }
                                <label class="form-check-label" for="o_@(i)_@opcion.Id">@opcion.Texto</label>
                            </div>
                        }
                    }
                    else
                    {
                        <input asp-for="Respuestas[i].Texto" class="form-control" autocomplete="off" />
                    }
                </div>
            </div>
        }

        <div class="d-flex justify-content-end">
            <button class="app-btn app-btn-soft-primary" type="submit">Finalizar cuestionario</button>
        </div>
    </form>
</div>
