@model Proyecto_Final.ViewModels.Alumnos.CrearAlumno
@using Microsoft.AspNetCore.Mvc.Rendering
@using Proyecto_Final.Models

@{
    ViewData["Title"] = "Nuevo alumno";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Nuevo alumno</h2>
            <p class="text-muted mb-0">Registre la cuenta, el perfil del alumno y su inscripción inicial.</p>
        </div>
        <a asp-action="Index" class="app-btn app-btn-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <div class="app-card">
        <div class="app-card-body">
            <form asp-action="Crear" method="post" novalidate data-crear-alumno>
                @Html.AntiForgeryToken()
                <partial name="Formulario" model="Model" />

                <hr class="my-4" />

                <h5 class="fw-semibold mb-3">Inscripción académica</h5>
                @if (Model.CiclosInactivosConSecciones.Count > 0)
                {
                    <div class="alert alert-warning" role="alert">
                        <h6 class="alert-heading">Ciclo escolar inactivo</h6>
                        @if (Model.CiclosInactivosConSecciones.Count == 1)
                        {
                            <p class="mb-0">El ciclo escolar @Model.CiclosInactivosConSecciones[0] se encuentra inactivo. Para inscribir alumnos en sus secciones, primero debe activarlo desde Configuración → Ciclos.</p>
                        }
                        else
                        {
                            <p class="mb-0">Los ciclos escolares @string.Join(", ", Model.CiclosInactivosConSecciones) se encuentran inactivos. Para inscribir alumnos en sus secciones, primero debe activarlos desde Configuración → Ciclos.</p>
                        }
                    </div>
                }
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="SeccionId" class="form-label"></label>
                        <select asp-for="SeccionId"
                                asp-items="@(new SelectList(Model.Secciones, "Id", "Texto"))"
                                class="form-select" data-select-busqueda>
                            <option value="0">Seleccione...</option>
                        </select>
                        <span asp-validation-for="SeccionId" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />
                <h5 class="fw-semibold mb-3">Datos del encargado</h5>
                <div class="form-check mb-3">
                    <input asp-for="RegistrarEncargadoAhora" class="form-check-input" data-registrar-encargado />
                    <label asp-for="RegistrarEncargadoAhora" class="form-check-label"></label>
                </div>
                <div class="row g-3 d-none" data-datos-encargado>
                    <div class="col-md-6"><label asp-for="DatosEncargado.Nombres" class="form-label"></label><input asp-for="DatosEncargado.Nombres" class="form-control" /><span asp-validation-for="DatosEncargado.Nombres" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="DatosEncargado.Apellidos" class="form-label"></label><input asp-for="DatosEncargado.Apellidos" class="form-control" /><span asp-validation-for="DatosEncargado.Apellidos" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="DatosEncargado.Dpi" class="form-label"></label><input asp-for="DatosEncargado.Dpi" class="form-control" inputmode="numeric" /><span asp-validation-for="DatosEncargado.Dpi" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="DatosEncargado.Telefono" class="form-label"></label><input asp-for="DatosEncargado.Telefono" class="form-control" /><span asp-validation-for="DatosEncargado.Telefono" class="text-danger"></span></div>
                    <div class="col-md-6"><label asp-for="DatosEncargado.TelefonoAlterno" class="form-label"></label><input asp-for="DatosEncargado.TelefonoAlterno" class="form-control" /></div>
                    <div class="col-md-6"><label asp-for="DatosEncargado.Correo" class="form-label"></label><input asp-for="DatosEncargado.Correo" class="form-control" type="email" /><span asp-validation-for="DatosEncargado.Correo" class="text-danger"></span></div>
                    <div class="col-12"><label asp-for="DatosEncargado.Direccion" class="form-label"></label><textarea asp-for="DatosEncargado.Direccion" class="form-control" rows="2"></textarea></div>
                    <div class="col-md-6"><label asp-for="ParentescoEncargado" class="form-label"></label><select asp-for="ParentescoEncargado" asp-items="Html.GetEnumSelectList<TipoParentesco>()" class="form-select"><option value="">Seleccione...</option></select><span asp-validation-for="ParentescoEncargado" class="text-danger"></span></div>
                </div>

                <div class="app-alert app-alert-info mt-4">
                    <i class="bi bi-info-circle"></i>
                    <div>Usuario, alumno e inscripción se guardan como una sola operación. Si una parte falla, no se conservarán registros parciales. Se generará una contraseña temporal que el alumno deberá cambiar al ingresar.</div>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="app-btn app-btn-secondary">Cancelar</a>
                    <button type="submit" class="app-btn app-btn-primary"><i class="bi bi-check-lg"></i> Guardar alumno</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/alumnos.js" asp-append-version="true"></script>
}
