@model Proyecto_Final.ViewModels.Materiales.FormularioMaterial
@using Proyecto_Final.Models

@{
    var archivoActual = (Model as Proyecto_Final.ViewModels.Materiales.EditarMaterial)?.ArchivoActual;
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3">
</div>

<div class="row g-3">
    <div class="col-md-7">
        <label asp-for="UnidadId" class="form-label">
            Unidad
        </label>

        <select asp-for="UnidadId" class="form-select" data-select-busqueda>
            <option value="">Seleccione...</option>

            @foreach (var x in Model.Unidades)
            {
                <option value="@x.Id">
                    @x.Texto
                </option>
            }
        </select>
    </div>

    <div class="col-md-5">
        <label asp-for="Tipo" class="form-label">
            Tipo
        </label>

        <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<TipoMaterial>()"
                class="form-select" data-material-tipo>
        </select>
    </div>

    <div class="col-12">
        <label asp-for="Titulo" class="form-label">
            Título
        </label>

        <input asp-for="Titulo" class="form-control" />
    </div>

    <div class="col-12">
        <label asp-for="Descripcion" class="form-label">
            Descripción
        </label>

        <textarea asp-for="Descripcion" class="form-control" rows="3">
        </textarea>
    </div>

    <div class="col-12" data-material-archivo data-tiene-archivo-actual="@(!string.IsNullOrWhiteSpace(archivoActual) ? "true" : "false")">
        <label asp-for="Archivo" class="form-label">
            Archivo
        </label>

        <input asp-for="Archivo" type="file" class="form-control" data-material-archivo-input />
        <span asp-validation-for="Archivo" class="text-danger"></span>

        <span class="form-text">
            Máximo 25 MB. Formatos admitidos: PDF, Office, texto, imágenes, audio y video.
        </span>
    </div>

    <div class="col-12" data-material-url>
        <label asp-for="UrlExterna" class="form-label">
            URL externa
        </label>

        <input asp-for="UrlExterna" type="url" class="form-control" placeholder="https://..."
               inputmode="url" data-material-url-input />
        <span asp-validation-for="UrlExterna" class="text-danger"></span>
        <span class="form-text">Use preferentemente una dirección HTTPS.</span>
    </div>

    <div class="col-12" data-material-descarga>
        <div class="form-check">
            <input asp-for="Descargable" class="form-check-input" />

            <label asp-for="Descargable" class="form-check-label">
                Permitir descarga al alumno
            </label>
        </div>
    </div>
</div>
