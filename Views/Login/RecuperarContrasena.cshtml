@model Proyecto_Final.ViewModels.Autenticacion.RecuperarContrasena

@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = null;

    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors
        .Select(x => x.ErrorMessage)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList();
}

<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Recuperar contraseña - SabIA</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<body class="bg-light">

    @if (erroresGenerales?.Any() == true)
    {
        <div data-alerta data-tipo="error" data-titulo="Recuperación de contraseña"
             data-mensaje="@string.Join(" ", erroresGenerales)" hidden>
        </div>
    }

    <div class="container">

        <div class="row justify-content-center align-items-center min-vh-100">

            <div class="col-12 col-sm-10 col-md-7 col-lg-5">

                <div class="card shadow border-0">

                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">

                            <h2 class="fw-bold mb-2">
                                Recuperar contraseña
                            </h2>

                            <p class="text-muted mb-0">
                                Ingrese el correo electrónico asociado
                                a su cuenta.
                            </p>

                        </div>

                        <form asp-controller="Login" asp-action="RecuperarContrasena" method="post" novalidate>

                            @Html.AntiForgeryToken()

                            <div class="mb-4">

                                <label asp-for="Correo" class="form-label">
                                </label>

                                <input asp-for="Correo" class="form-control" autocomplete="email" autofocus />

                                <span asp-validation-for="Correo" class="text-danger small">
                                </span>

                            </div>

                            <div class="d-grid gap-2">

                                <button type="submit" class="btn btn-primary btn-lg">
                                    Enviar enlace de recuperación
                                </button>

                                <a asp-controller="Login" asp-action="Login" class="btn btn-outline-secondary">
                                    Regresar al login
                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/alertas.js" asp-append-version="true"></script>

</body>

</html>