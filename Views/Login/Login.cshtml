@model Proyecto_Final.ViewModels.Autenticacion.Login

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;

    var erroresGenerales = ViewData.ModelState[string.Empty]?.Errors
        .Select(x => x.ErrorMessage)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar sesión - SabIA</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@4.0.0-rc6/dist/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page bg-body-secondary">
    @if (erroresGenerales?.Any() == true)
    {
        <div data-alerta data-tipo="error" data-titulo="Inicio de sesión" data-mensaje="@string.Join(" ", erroresGenerales)" hidden></div>
    }

    @if (TempData["Exito"] is string mensajeExito)
    {
        <div data-alerta data-tipo="success" data-titulo="Correcto" data-mensaje="@mensajeExito" hidden></div>
    }

    <div class="login-box">
        <div class="login-logo mb-3">
            <a href="#" class="text-decoration-none text-body">
                <i class="bi bi-mortarboard-fill text-primary me-2"></i><b>Sab</b>IA
            </a>
        </div>

        <div class="card card-outline card-primary shadow">
            <div class="card-header text-center border-0 pt-4">
                <h1 class="h4 mb-1 fw-semibold">Bienvenido</h1>
                <p class="text-body-secondary mb-0">Ingrese sus credenciales para continuar</p>
            </div>
            <div class="card-body login-card-body">
                <form asp-controller="Login" asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="urlRetorno" value="@ViewData["UrlRetorno"]" />

                    <div class="mb-3">
                        <label asp-for="Usuario" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Usuario" class="form-control" autocomplete="username" autofocus />
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                        </div>
                        <span asp-validation-for="Usuario" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Contrasena" class="form-control" autocomplete="current-password" />
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger small"></span>
                    </div>

                    <div class="row align-items-center mb-3">
                        <div class="col-6">
                            <div class="form-check">
                                <input asp-for="Recordarme" class="form-check-input" />
                                <label asp-for="Recordarme" class="form-check-label"></label>
                            </div>
                        </div>
                        <div class="col-6 text-end">
                            <a asp-controller="Login" asp-action="RecuperarContrasena" class="small text-decoration-none">
                                ¿Olvidó su contraseña?
                            </a>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Ingresar
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <p class="text-center text-body-secondary small mt-3 mb-0">
            Sistema de apoyo académico · Proyecto Final
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/alertas.js" asp-append-version="true"></script>
</body>
</html>
