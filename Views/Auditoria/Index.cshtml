
@model Proyecto_Final.ViewModels.Auditoria.AuditoriaIndice
@using Proyecto_Final.Models

@{
    ViewData["Title"] = "Auditoría";

    string ClaseResultado(ResultadoAuditoria resultado) => resultado switch
    {
        ResultadoAuditoria.Exitoso => "text-bg-success",
        ResultadoAuditoria.Rechazado => "text-bg-warning",
        _ => "text-bg-danger"
    };
}

<div class="container-fluid">

    <!-- Encabezado -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Auditoría</h2>
        <p class="text-muted mb-0">
            Trazabilidad de operaciones y eventos de seguridad.
        </p>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get"
                  asp-action="Index"
                  class="row g-3"
                  aria-label="Filtros de auditoría">

                <div class="col-12 col-sm-6 col-lg-2">
                    <label asp-for="Filtro.FechaDesde"
                           class="form-label"></label>
                    <input asp-for="Filtro.FechaDesde"
                           name="FechaDesde"
                           class="form-control" />
                </div>

                <div class="col-12 col-sm-6 col-lg-2">
                    <label asp-for="Filtro.FechaHasta"
                           class="form-label"></label>
                    <input asp-for="Filtro.FechaHasta"
                           name="FechaHasta"
                           class="form-control" />
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <label asp-for="Filtro.Responsable"
                           class="form-label"></label>
                    <input asp-for="Filtro.Responsable"
                           name="Responsable"
                           class="form-control"
                           maxlength="100" />
                </div>

                <div class="col-12 col-sm-6 col-lg-2">
                    <label asp-for="Filtro.Modulo"
                           class="form-label"></label>
                    <input asp-for="Filtro.Modulo"
                           name="Modulo"
                           class="form-control"
                           maxlength="80" />
                </div>

                <div class="col-12 col-sm-6 col-lg-2">
                    <label asp-for="Filtro.Accion"
                           class="form-label"></label>
                    <input asp-for="Filtro.Accion"
                           name="Accion"
                           class="form-control"
                           maxlength="120" />
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <label asp-for="Filtro.Resultado"
                           class="form-label"></label>
                    <select asp-for="Filtro.Resultado"
                            name="Resultado"
                            asp-items="Html.GetEnumSelectList<ResultadoAuditoria>()"
                            class="form-select">
                        <option value="">Todos</option>
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-lg-3">
                    <label asp-for="Filtro.DireccionIp"
                           class="form-label"></label>
                    <input asp-for="Filtro.DireccionIp"
                           name="DireccionIp"
                           class="form-control"
                           maxlength="45" />
                </div>

                <div class="col-12 col-lg-6 d-flex flex-wrap align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        Filtrar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Limpiar
                    </a>
                </div>

                <div class="col-12">
                    <div class="form-text">
                        Las fechas se interpretan en horario de Guatemala.
                    </div>
                </div>

            </form>
        </div>
    </div>

    <!-- Resultados -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <!-- Resumen -->
            <div class="d-flex flex-wrap justify-content-between
                        align-items-center gap-2 mb-3">

                <span class="text-muted">
                    @Model.TotalRegistros registro(s)
                </span>

                <span class="text-muted">
                    Página @Model.Pagina de @Model.TotalPaginas
                </span>
            </div>

            @if (Model.Registros.Count == 0)
            {
                <!-- Estado vacío único -->
                <div class="text-center text-muted py-5">
                    <i class="bi bi-journal-x fs-2 d-block mb-2"
                       aria-hidden="true"></i>

                    No hay eventos que coincidan con los filtros.
                </div>
            }
            else
            {
                <!-- =====================================
                     ESCRITORIO: TABLA
                     >= 992px
                     ===================================== -->
                <div class="d-none d-lg-block">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">

                            <thead>
                                <tr>
                                    <th scope="col">
                                        Fecha y hora (Guatemala)
                                    </th>
                                    <th scope="col">Responsable</th>
                                    <th scope="col">Módulo</th>
                                    <th scope="col">Acción</th>
                                    <th scope="col">Resultado</th>
                                    <th scope="col">IP</th>
                                    <th scope="col" class="text-end">
                                        Acciones
                                    </th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var registro in Model.Registros)
                                {
                                    <tr>
                                        <td class="text-nowrap">
                                            @registro.FechaHoraGuatemala.ToString("dd/MM/yyyy HH:mm:ss")
                                        </td>

                                        <td class="text-break">
                                            @registro.Responsable
                                        </td>

                                        <td class="text-break">
                                            @registro.Modulo
                                        </td>

                                        <td class="text-break">
                                            @registro.Accion
                                        </td>

                                        <td>
                                            <span class="badge @ClaseResultado(registro.Resultado)">
                                                @registro.Resultado.GetDisplayName()
                                            </span>
                                        </td>

                                        <td>
                                            <code>
                                                @(registro.DireccionIp ?? "—")
                                            </code>
                                        </td>

                                        <td class="text-end text-nowrap">
                                            <a asp-action="Detalle"
                                               asp-route-id="@registro.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Ver detalle
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                </div>

                <!-- =====================================
                     MÓVIL Y TABLET: TARJETAS
                     < 992px
                     ===================================== -->
                <div class="d-lg-none">

                    @foreach (var registro in Model.Registros)
                    {
                        <article class="card border mb-3">

                            <div class="card-body">

                                <!-- Responsable y resultado -->
                                <div class="d-flex flex-wrap
                                            justify-content-between
                                            align-items-start gap-2 mb-2">

                                    <div class="fw-semibold text-break">
                                        @registro.Responsable
                                    </div>

                                    <span class="badge @ClaseResultado(registro.Resultado)">
                                        @registro.Resultado.GetDisplayName()
                                    </span>
                                </div>

                                <!-- Fecha -->
                                <div class="small text-muted mb-3">
                                    <i class="bi bi-clock me-1"
                                       aria-hidden="true"></i>

                                    <time datetime="@registro.FechaHoraGuatemala.ToString("yyyy-MM-ddTHH:mm:ss")">
                                        @registro.FechaHoraGuatemala.ToString("dd/MM/yyyy HH:mm:ss")
                                    </time>
                                </div>

                                <!-- Datos del evento -->
                                <dl class="row g-2 small mb-3">

                                    <dt class="col-4">
                                        Módulo
                                    </dt>

                                    <dd class="col-8 text-break mb-0">
                                        @registro.Modulo
                                    </dd>

                                    <dt class="col-4">
                                        Acción
                                    </dt>

                                    <dd class="col-8 text-break mb-0">
                                        @registro.Accion
                                    </dd>

                                    <dt class="col-4">
                                        IP
                                    </dt>

                                    <dd class="col-8 text-break mb-0">
                                        <code class="text-break">
                                            @(registro.DireccionIp ?? "—")
                                        </code>
                                    </dd>

                                </dl>

                                <!-- Acción -->
                                <a asp-action="Detalle"
                                   asp-route-id="@registro.Id"
                                   class="btn btn-outline-primary btn-sm w-100">

                                    <i class="bi bi-eye me-1"
                                       aria-hidden="true"></i>

                                    Ver detalle
                                </a>

                            </div>
                        </article>
                    }

                </div>
            }

            <!-- =====================================
                 PAGINACIÓN COMPARTIDA
                 ===================================== -->
            @if (Model.TotalPaginas > 1)
            {
                <nav aria-label="Paginación de auditoría"
                     class="mt-3">

                    <ul class="pagination pagination-sm
                               justify-content-center
                               justify-content-lg-end
                               flex-wrap gap-1 mb-0">

                        <!-- Anterior -->
                        <li class="page-item @(Model.Pagina == 1 ? "disabled" : null)">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(Model.Pagina - 1)"
                               asp-route-fechaDesde="@Model.Filtro.FechaDesde"
                               asp-route-fechaHasta="@Model.Filtro.FechaHasta"
                               asp-route-responsable="@Model.Filtro.Responsable"
                               asp-route-modulo="@Model.Filtro.Modulo"
                               asp-route-accion="@Model.Filtro.Accion"
                               asp-route-resultado="@Model.Filtro.Resultado"
                               asp-route-direccionIp="@Model.Filtro.DireccionIp"
                               aria-disabled="@(Model.Pagina == 1 ? "true" : "false")">

                                Anterior
                            </a>
                        </li>

                        <!-- Página actual -->
                        <li class="page-item disabled">
                            <span class="page-link">
                                @Model.Pagina / @Model.TotalPaginas
                            </span>
                        </li>

                        <!-- Siguiente -->
                        <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : null)">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(Model.Pagina + 1)"
                               asp-route-fechaDesde="@Model.Filtro.FechaDesde"
                               asp-route-fechaHasta="@Model.Filtro.FechaHasta"
                               asp-route-responsable="@Model.Filtro.Responsable"
                               asp-route-modulo="@Model.Filtro.Modulo"
                               asp-route-accion="@Model.Filtro.Accion"
                               asp-route-resultado="@Model.Filtro.Resultado"
                               asp-route-direccionIp="@Model.Filtro.DireccionIp"
                               aria-disabled="@(Model.Pagina == Model.TotalPaginas ? "true" : "false")">

                                Siguiente
                            </a>
                        </li>

                    </ul>
                </nav>
            }

        </div>
    </div>

</div>
