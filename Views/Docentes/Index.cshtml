@model IEnumerable<Proyecto_Final.ViewModels.Docentes.DocenteLista>
@using Microsoft.AspNetCore.Authorization
@using Proyecto_Final.Seguridad
@inject IAuthorizationService Autorizacion

@{
    ViewData["Title"] = "Docentes";

    var puedeVer = (await Autorizacion.AuthorizeAsync(User, Permisos.Docentes.Ver)).Succeeded;
    var puedeCrear = (await Autorizacion.AuthorizeAsync(User, Permisos.Docentes.Crear)).Succeeded;
    var puedeEditar = (await Autorizacion.AuthorizeAsync(User, Permisos.Docentes.Editar)).Succeeded;
    var puedeCambiarEstado = (await Autorizacion.AuthorizeAsync(User, Permisos.Docentes.CambiarEstado)).Succeeded;
    var hayDocentes = Model.Any();
}

<div class="container-fluid">
    <partial name="_AlertasResultado" />

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Docentes</h2>
            <p class="text-muted mb-0">Administración de docentes y sus cuentas de acceso.</p>
        </div>

        @if (puedeCrear)
        {
            <div class="d-grid d-md-block">
                <a asp-action="Crear" class="app-btn app-btn-soft-primary">Nuevo docente</a>
            </div>
        }
    </div>

    @if (hayDocentes)
    {
        <div class="d-md-none mb-3">
            <div class="d-grid">
                <button type="button" class="app-btn app-btn-secondary"
                        aria-expanded="false" aria-controls="busqueda-docentes-movil"
                        data-mostrar-busqueda-docentes>
                    <i class="bi bi-search" aria-hidden="true"></i>
                    Buscar docente
                </button>
            </div>
            <div id="busqueda-docentes-movil" class="mt-2 d-none" data-contenedor-busqueda-docentes>
                <input type="search" class="form-control"
                       placeholder="Carnet, nombre, correo, título, nivel o estado..."
                       aria-label="Buscar docentes" autocomplete="off" data-busqueda-docentes />
            </div>
        </div>
    }

    <div class="card shadow-sm border border-secondary d-none d-md-block">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table app-table w-100" data-tabla-index data-actions-column="true"
                       data-search-placeholder="Carnet, nombre, correo, título, nivel o estado..."
                       data-empty-message="No existen docentes registrados" data-zero-message="No se encontraron docentes">
                    <thead>
                        <tr>
                            <th>Carnet</th>
                            <th>Docente</th>
                            <th>Correo</th>
                            <th>Nivel académico</th>
                            <th class="dt-head-left">Asignaciones</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var docente in Model)
                        {
                            <tr>
                                <td>@docente.Carnet</td>
                                <td>
                                    <div class="fw-semibold">@docente.NombreCompleto</div>
                                    @if (!string.IsNullOrWhiteSpace(docente.Titulo))
                                    {
                                        <div class="text-muted small">@docente.Titulo</div>
                                    }
                                </td>
                                <td>@docente.Correo</td>
                                <td>@(docente.NivelAcademico?.ToString() ?? "Sin registrar")</td>
                                <td>@docente.AsignacionesActivas</td>
                                <td>
                                    <span class="app-badge @(docente.Activo ? "app-badge-success" : "app-badge-danger")">
                                        @(docente.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>
                                    <div class="app-actions app-actions-table">
                                        @if (puedeVer)
                                        {
                                            <a asp-action="Ver" asp-route-id="@docente.Id"
                                               class="app-btn-icon" title="Ver docente"
                                               aria-label="Ver docente @docente.NombreCompleto">
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                            </a>
                                        }

                                        @if (puedeEditar)
                                        {
                                            <a asp-action="Editar" asp-route-id="@docente.Id"
                                               class="app-btn app-btn-soft-secondary app-btn-sm">Editar</a>
                                        }

                                        @if (puedeCambiarEstado)
                                        {
                                            <form asp-action="@(docente.Activo ? "Desactivar" : "Activar")"
                                                  asp-route-id="@docente.Id" method="post" class="m-0" data-cambiar-estado-docente
                                                  data-accion="@(docente.Activo ? "desactivar" : "activar")">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="app-btn @(docente.Activo ? "app-btn-soft-danger" : "app-btn-soft-success") app-btn-sm">
                                                    @(docente.Activo ? "Desactivar" : "Activar")
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-md-none" data-contenedor-docentes-movil>
        @foreach (var docente in Model)
        {
            var nivelAcademico = docente.NivelAcademico?.ToString() ?? "Sin registrar";
            var estado = docente.Activo ? "Activo" : "Inactivo";
            var busqueda = $"{docente.Carnet} {docente.NombreCompleto} {docente.Correo} " +
                $"{docente.Titulo} {nivelAcademico} {docente.AsignacionesActivas} {estado}";

            <div class="card shadow-sm border-0 mb-3" data-docente data-texto-busqueda="@busqueda">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <div class="fw-bold fs-5">@docente.NombreCompleto</div>
                            <div class="text-muted small">@docente.Carnet</div>
                            @if (!string.IsNullOrWhiteSpace(docente.Titulo))
                            {
                                <div class="text-muted small mt-1">@docente.Titulo</div>
                            }
                        </div>
                        <span class="app-badge @(docente.Activo ? "app-badge-success" : "app-badge-danger")">
                            @(docente.Activo ? "Activo" : "Inactivo")
                        </span>
                    </div>

                    <div class="small text-muted">Correo</div>
                    <div class="text-break mb-3">@docente.Correo</div>

                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <div class="small text-muted">Nivel académico</div>
                            <div>@nivelAcademico</div>
                        </div>
                        <div class="col-6">
                            <div class="small text-muted">Asignaciones</div>
                            <div>@docente.AsignacionesActivas</div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        @if (puedeVer)
                        {
                            <a asp-action="Ver" asp-route-id="@docente.Id"
                               class="app-btn app-btn-soft-secondary app-btn-sm">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                                Ver
                            </a>
                        }

                        @if (puedeEditar)
                        {
                            <a asp-action="Editar" asp-route-id="@docente.Id" class="app-btn app-btn-soft-secondary">Editar</a>
                        }

                        @if (puedeCambiarEstado)
                        {
                            <form asp-action="@(docente.Activo ? "Desactivar" : "Activar")" asp-route-id="@docente.Id"
                                  method="post" data-cambiar-estado-docente
                                  data-accion="@(docente.Activo ? "desactivar" : "activar")">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="app-btn @(docente.Activo ? "app-btn-soft-danger" : "app-btn-soft-success") w-100">
                                    @(docente.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="app-card @(hayDocentes ? "d-none" : null)" data-docentes-sin-resultados role="status">
            <div class="app-card-body text-center text-muted">
                @(hayDocentes ? "No se encontraron docentes." : "No existen docentes registrados.")
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/docentes.js" asp-append-version="true"></script>
}
