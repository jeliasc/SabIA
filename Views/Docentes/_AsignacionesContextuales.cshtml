@model IReadOnlyList<Proyecto_Final.ViewModels.Docentes.AsignacionDocenteContextual>
@if (Model.Count == 0)
{
    <div class="app-alert app-alert-info mb-0">No hay asignaciones vigentes para mostrar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table app-table mb-0">
            <thead>
                <tr>
                    <th>Curso</th>
                    <th>Ciclo</th>
                    <th>Grado y sección</th>
                    <th>Carrera</th>
                </tr>
            </thead>
            <tbody>@foreach (var asignacion in Model) {
                <tr>
                    <td class="fw-semibold">@asignacion.Curso</td>
                    <td>@asignacion.CicloEscolar</td>
                    <td>@asignacion.Grado @asignacion.Seccion</td>
                    <td>@asignacion.Carrera</td>
                </tr>
            }
        </tbody>
    </table>
</div>
}
