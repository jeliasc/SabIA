@model Proyecto_Final.ViewModels.Docentes.EditarDocente

@{
    ViewData["Title"] = "Editar docente";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Editar docente</h2>
            <p class="text-muted mb-0">Actualice la información personal y académica del docente.</p>
        </div>
        <a asp-action="Index" class="app-btn app-btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Volver
        </a>
    </div>

    <div class="app-card">
        <div class="app-card-body">
            <div class="app-alert app-alert-info-danger-text mb-4">
                <i class="bi bi-info-circle"></i>
                <div>La contraseña no se modifica desde esta pantalla.</div>
            </div>

            <form asp-action="Editar" method="post" novalidate data-editar-docente>
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <partial name="Formulario" model="Model" />

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="app-btn app-btn-secondary">Cancelar</a>
                    <button type="submit" class="app-btn app-btn-primary">
                        <i class="bi bi-check-lg"></i>
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/docentes.js" asp-append-version="true"></script>
}
