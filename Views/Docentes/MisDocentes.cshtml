@model IReadOnlyList<Proyecto_Final.ViewModels.Docentes.DocenteContextual>
@{
    ViewData["Title"] = "Mis docentes";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <div class="mb-4">
                <h2 class="fw-bold mb-1">Mis docentes</h2>
                <p class="text-muted mb-0">Responsables de mis cursos vigentes.</p>
            </div>@if (Model.Count == 0) {
            <div class="app-alert app-alert-info">No hay docentes responsables
                disponibles para tu inscripción vigente.</div>
            } else
            {

                <div class="row g-3">@foreach (var docente in
                    Model) {
                        <div class="col-12">
                            <div class="card shadow-sm border border-secondary">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">@docente.NombreCompleto</h5>
                                    <partial name="_AsignacionesContextuales" model="docente.Asignaciones" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>