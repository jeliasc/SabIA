@model IReadOnlyList<Proyecto_Final.ViewModels.Docentes.DocenteContextual>
@{
    ViewData["Title"] = "Directorio docente";
}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-9">
            <div class="mb-4">
                <h2 class="fw-bold mb-1">Directorio docente</h2>
                <p class="text-muted mb-0">Información institucional básica de docentes activos.</p>
            </div>@if (Model.Count == 0) {
            <div class="app-alert app-alert-info">No hay otros docentes activos
                registrados.</div>
            } else
            {

                <div class="row g-3">@foreach (var docente in Model) {
                    <div
                        class="col-12 col-md-6">
                        <div class="app-card h-100">
                            <div class="app-card-body">
                                <div class="fw-semibold">@docente.NombreCompleto</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
</div>